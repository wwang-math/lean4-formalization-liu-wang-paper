theorem chartBeamVerificationBundle_reflectedBoundaryRate {d : Nat} (rho : Real)
    (hrho : 0 < rho) (phi1 phi2 : (Fin d -> Real) -> Complex) {C b : Real} {N : Nat}
    (hC : 0 ≤ C) (hb : 0 < b)
    (hdiff : ∀ y, ‖phi1 y - phi2 y‖
      ≤ C * (LiuWang2025SemilinearWaveGaussianL2Bridge.radius y) ^ (N + 1))
    (hcoer1 : ∀ y, b * LiuWang2025SemilinearWaveGaussianMassScaling.radiusSq y
      ≤ (phi1 y).im)
    (hcoer2 : ∀ y, b * LiuWang2025SemilinearWaveGaussianMassScaling.radiusSq y
      ≤ (phi2 y).im) :
    Real.sqrt (∫ y : Fin d -> Real,
        ‖Complex.exp (Complex.I * (rho : Complex) * phi1 y)
          - Complex.exp (Complex.I * (rho : Complex) * phi2 y)‖ ^ 2)
      ≤ C * Real.sqrt (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d
            (1 + (N + 1 - 1)) (2 * b))
          * rho ^ (-(((N : Real) - 2 + 1) / 2) - (d : Real) / 4) :=
  LiuWang2025SemilinearWaveChartBeamReflection.reflectedBoundary_L2_rate_of_phaseMatching
    rho hrho phi1 phi2 hC hb hdiff hcoer1 hcoer2

/-- **The Riccati quadratic phase, as a constructed jet.**  Its transverse
2-jet is the symmetrization `H_{ml} + H_{lm}` of the Riccati unknown, obtained
by differentiating the displayed quadratic form. -/
theorem chartBeamVerificationBundle_quadraticPhaseJet {n : Nat}
    (H : Fin n -> Fin n -> Complex) (c : Complex) (l m : Fin n) (x : Fin n -> Real) :
    (LiuWang2025SemilinearWaveChartQuadraticPhase.quadraticPhaseJet H c).d2 l m x
      = H m l + H l m :=
  LiuWang2025SemilinearWaveChartQuadraticPhase.quadraticPhaseJet_d2 H c l m x

/-- **The constructed phase supplies the Gaussian coercivity.**  Positive
