/-- **The unconditional WKB expansion.**  An identity, valid at every chart
point with no cancellation assumed: the leading transport expression carries
one power of the frequency, the hierarchy expressions carry `rho^{-m}`, the
terminal term `rho^{-N}`, and the eikonal symbol `rho^2`. -/
theorem chartBeamVerificationBundle_unconditionalExpansion {n : Nat}
    (A : Fin n -> Fin n -> (Fin n -> Real) -> Complex)
    (B : Fin n -> (Fin n -> Real) -> Complex) (rho : Real)
    (hrho : (rho : Complex) ≠ 0)
    (phi : LiuWang2025SemilinearWaveChartWKB.ChartJet n)
    (b : Nat -> LiuWang2025SemilinearWaveChartWKB.ChartJet n) (N : Nat)
    (x : Fin n -> Real) :
    LiuWang2025SemilinearWaveChartWKB.ChartJet.waveOp A B
        (LiuWang2025SemilinearWaveChartWKB.ChartJet.beam
          (Complex.I * (rho : Complex)) phi
          (LiuWang2025SemilinearWaveChartBeamResidual.truncatedAmplitude rho b N)) x
      = Complex.exp (Complex.I * (rho : Complex) * phi.val x)
        * (Complex.I * (rho : Complex)
              * LiuWang2025SemilinearWaveChartWKB.ChartJet.transportTerm A B phi (b 0) x
            + (∑ m ∈ Finset.range N, ((rho : Complex))⁻¹ ^ m
                * LiuWang2025SemilinearWaveChartBeamAssembly.hierarchyExpr A B phi b m x)
            + ((rho : Complex))⁻¹ ^ N
                * LiuWang2025SemilinearWaveChartWKB.ChartJet.waveOp A B (b N) x
            - (rho : Complex) ^ 2
                * (LiuWang2025SemilinearWaveChartBeamResidual.truncatedAmplitude rho b N).val x
                * LiuWang2025SemilinearWaveChartWKB.ChartJet.eikonalSymbol A phi x) :=
  LiuWang2025SemilinearWaveChartBeamAssembly.waveOp_beam_expand A B rho hrho phi b N x

/-- **The finite Taylor remainder estimate.**  Vanishing of every directional
derivative through order `N` at the centre, plus a bound on the order-`N+1`
directional derivatives in unit directions over the tube, forces the
`O(|z|^{N+1})` bound.  The polynomial bound is the conclusion. -/
theorem chartBeamVerificationBundle_taylorRemainder {n N : Nat}
    (J : LiuWang2025SemilinearWaveDirectionalJet.DirJet n N) {M r : Real}
    (hvanish : ∀ l : List (Fin n -> Real), l.length ≤ N -> J.D l 0 = 0)
    (hbound : ∀ u : Fin n -> Real,
      LiuWang2025SemilinearWaveGaussianL2Bridge.radius u = 1 ->
      ∀ y : Fin n -> Real,
        LiuWang2025SemilinearWaveGaussianL2Bridge.radius y ≤ r ->
        ‖J.D (List.replicate (N + 1) u) y‖ ≤ M)
    (z : Fin n -> Real)
    (hz : LiuWang2025SemilinearWaveGaussianL2Bridge.radius z ≤ r) :
    ‖J.D [] z‖
      ≤ M * (LiuWang2025SemilinearWaveGaussianL2Bridge.radius z) ^ (N + 1) :=
  LiuWang2025SemilinearWaveDirectionalJet.taylor_remainder_bound J hvanish hbound z hz

/-- **The source's equation-(3.11) rate, from the source's jet conditions.**
The eikonal symbol, the leading transport expression and every hierarchy
expression are only required to satisfy the finite-order jet conditions the
source imposes.  The polynomial bounds, the Gaussian gain and the exponent are
derived; no estimate is assumed anywhere in the chain. -/
theorem chartBeamVerificationBundle_finiteOrderEquation311 {n : Nat}
    (A : Fin n -> Fin n -> (Fin n -> Real) -> Complex)
    (B : Fin n -> (Fin n -> Real) -> Complex)
    (rho : Real) (hrho : 1 ≤ rho)
    (phi : LiuWang2025SemilinearWaveChartWKB.ChartJet n)
    (b : Nat -> LiuWang2025SemilinearWaveChartWKB.ChartJet n) (N : Nat)
    {coer Ca MT MH Me r : Real} (hcoer : 0 < coer)
    (hMT : 0 ≤ MT) (hMH : 0 ≤ MH) (hMe : 0 ≤ Me) (hCa : 0 ≤ Ca)
    (hIm : ∀ x, coer * LiuWang2025SemilinearWaveGaussianMassScaling.radiusSq x
