      LiuWang2025SemilinearWavePhaseUpdate.C1Data G P ∧
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a ≤ 2 ->
          P.phi.c a s = base.phi.c a s) ∧
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a ≤ 2 ->
          P.dphi.c a s = base.dphi.c a s) ∧
      (∀ s ∈ Set.Icc lo hi,
        ∀ a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d,
          LiuWang2025SemilinearWaveTransverseJet.deg a ≤ N ->
            LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att
