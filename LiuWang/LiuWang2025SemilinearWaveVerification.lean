/-- **Paper-dossier export of the rescaling at the actual oscillatory kernel.**
The source's integrand is `e^{i rho S}`, whose modulus is only *bounded* by a
Gaussian weight.  For the Riccati phase, which is exactly quadratic, the
frequency cancels against the degree-two homogeneity exactly, so the
`rho^{(n+1)/2}` normalization is again an identity rather than an asymptotic
statement. -/
theorem gaussianPhaseCoercivityVerificationBundle_quadraticRescaling
    {d : Nat} (H : Matrix (Fin d) (Fin d) Complex)
    (g : (Fin d -> Real) -> Complex) {rho : Real} (hrho : 0 < rho) :
    ((Real.sqrt rho ^ d : Real)) • (∫ z : Fin d -> Real,
        quadraticKernel H rho z * g z)
      = ∫ w : Fin d -> Real,
          Complex.exp (Complex.I * phaseValue H w) * g ((Real.sqrt rho)⁻¹ • w) :=
  rescaled_quadratic_integral H g hrho

/-- **Paper-dossier export of the stationary-phase limit at the complex
quadratic phase.**  Coercivity supplies the dominating Gaussian, so dominated
convergence gives the amplitude at the beam centre times the complex Gaussian
constant of equation (4.4). -/
theorem gaussianPhaseCoercivityVerificationBundle_quadraticLimit
    {d : Nat} (H : Matrix (Fin d) (Fin d) Complex)
    (g : (Fin d -> Real) -> Complex) {A b : Real} (hb : 0 < b)
    (hcoer : ∀ z : Fin d -> Real, b * radiusSq z ≤ (phaseValue H z).im)
    (hg : Continuous g) (hA : ∀ z, ‖g z‖ ≤ A) :
    Filter.Tendsto
      (fun rho : Real => ((Real.sqrt rho ^ d : Real)) • ∫ z : Fin d -> Real,
          quadraticKernel H rho z * g z)
      Filter.atTop
      (nhds ((∫ w : Fin d -> Real, Complex.exp (Complex.I * phaseValue H w))
        * g 0)) :=
  tendsto_normalized_quadratic_integral H g hb hcoer hg hA

/-- **Paper-dossier export of the pointwise conclusion at the actual kernel.**
With the boundary side vanishing by the reflected-beam estimate and the complex
