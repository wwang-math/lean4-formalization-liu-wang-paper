        * Real.sqrt (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d (2 * m) (2 * b)) :=
  sqrt_integral_normSq_le_of_profileBound hC hb hrho hf

/-- Paper-dossier export of the same estimate with the frequency powers carried
by the amplitude displayed separately: the source's `rho^{k - m - d/4}`. -/
theorem gaussianL2BridgeVerificationBundle_frequencyPowers
    {d : Nat} {f : (Fin d -> Real) -> Complex} {A k : Real} {m : Nat} {b rho : Real}
    (hA : 0 ≤ A) (hb : 0 < b) (hrho : 0 < rho)
    (hf : GaussianProfileBound f (A * rho ^ k) m (b * rho)) :
    Real.sqrt (∫ z : Fin d -> Real, ‖f z‖ ^ 2)
      ≤ A * Real.sqrt (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d (2 * m) (2 * b))
