/-- Paper-dossier export of Green's second identity in the variable normal to
the boundary, with the *exact* flux `[u' v - u v']` at both faces of the slab.
Every derivative is an actual derivative and every integral an actual interval
integral. -/
theorem spatialGreenVerificationBundle_secondIdentity
    {u du ddu v dv ddv : Real -> Complex} {xMin xMax : Real}
    (hu : ∀ x ∈ Set.uIcc xMin xMax, HasDerivAt u (du x) x)
    (hdu : ∀ x ∈ Set.uIcc xMin xMax, HasDerivAt du (ddu x) x)
    (hv : ∀ x ∈ Set.uIcc xMin xMax, HasDerivAt v (dv x) x)
    (hdv : ∀ x ∈ Set.uIcc xMin xMax, HasDerivAt dv (ddv x) x)
    (hduInt : IntervalIntegrable du MeasureTheory.volume xMin xMax)
    (hdduInt : IntervalIntegrable ddu MeasureTheory.volume xMin xMax)
    (hdvInt : IntervalIntegrable dv MeasureTheory.volume xMin xMax)
    (hddvInt : IntervalIntegrable ddv MeasureTheory.volume xMin xMax) :
    (∫ x in xMin..xMax, ddu x * v x) - (∫ x in xMin..xMax, u x * ddv x)
      = lateralFlux u du v dv xMin xMax :=
  green_secondIdentity hu hdu hv hdv hduInt hdduInt hdvInt hddvInt

/-- Paper-dossier export of the separated form: the tangential eigenvalue of
`Delta_k = d_x^2 - mu k` cancels and the lateral flux is unchanged. -/
theorem spatialGreenVerificationBundle_tangentialMode
    {u du ddu v dv ddv : Real -> Complex} {mu : Complex} {xMin xMax : Real}
    (hu : ∀ x ∈ Set.uIcc xMin xMax, HasDerivAt u (du x) x)
    (hdu : ∀ x ∈ Set.uIcc xMin xMax, HasDerivAt du (ddu x) x)
    (hv : ∀ x ∈ Set.uIcc xMin xMax, HasDerivAt v (dv x) x)
    (hdv : ∀ x ∈ Set.uIcc xMin xMax, HasDerivAt dv (ddv x) x)
    (hduInt : IntervalIntegrable du MeasureTheory.volume xMin xMax)
    (hdduInt : IntervalIntegrable ddu MeasureTheory.volume xMin xMax)
    (hdvInt : IntervalIntegrable dv MeasureTheory.volume xMin xMax)
    (hddvInt : IntervalIntegrable ddv MeasureTheory.volume xMin xMax)
    (hUV : IntervalIntegrable (fun x => u x * v x) MeasureTheory.volume xMin xMax)
    (hDdUV : IntervalIntegrable (fun x => ddu x * v x) MeasureTheory.volume xMin xMax)
    (hUDdV : IntervalIntegrable (fun x => u x * ddv x) MeasureTheory.volume xMin xMax) :
    (∫ x in xMin..xMax, tangentialLaplacian mu u ddu x * v x)
        - (∫ x in xMin..xMax, u x * tangentialLaplacian mu v ddv x)
      = lateralFlux u du v dv xMin xMax :=
  green_secondIdentity_tangentialMode hu hdu hv hdv hduInt hdduInt hdvInt
    hddvInt hUV hDdUV hUDdV

/-- Paper-dossier export of the equation-(4.3) structure on the concrete slab
core: homogeneous lateral Dirichlet data plus the accessible-face normal
derivative cancellation leave a single inaccessible-boundary term. -/
theorem spatialGreenVerificationBundle_inaccessibleFlux
    {Mode : Type*} (modes : Finset Mode) (timeHorizon xMin xMax : Real)
    (mu : Mode -> Complex) (u du ddu v dv ddv : Mode -> Real -> Real -> Complex)
    (hpointwise : ∀ k ∈ modes, ∀ t ∈ Set.uIcc (0 : Real) timeHorizon,
      (∫ x in xMin..xMax, tangentialLaplacian (mu k) (u k t) (ddu k t) x * v k t x)
          - (∫ x in xMin..xMax,
              u k t x * tangentialLaplacian (mu k) (v k t) (ddv k t) x)
