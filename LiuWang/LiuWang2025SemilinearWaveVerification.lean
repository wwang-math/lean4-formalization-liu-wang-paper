    rho ^ (k : Real)
        * Real.sqrt (∫ x : Real, x ^ (2 * m) * Real.exp (-(b * rho) * x ^ 2))
      = rho ^ ((k : Real) - (m : Real) / 2 - 1 / 4)
        * Real.sqrt (∫ y : Real, y ^ (2 * m) * Real.exp (-b * y ^ 2)) :=
