/-- **Paper-dossier export of the assembled cubic recovery.**  This is
Subsection 4.2 end to end for the Riccati phase: positivity of the transported
imaginary Hessian, the compactness step producing a uniform coercivity
constant, the exact rescaling at the oscillatory kernel, dominated convergence,
and the vanishing of the inaccessible-boundary term together force the
coefficient to vanish at the interaction point.  No coercivity constant is
supplied by the caller, and the amplitudes enter as the actual beam product. -/
theorem gaussianPhaseCoercivityVerificationBundle_assembledRecovery
    {d : Nat} {iota : Type} [Fintype iota] (H : Matrix (Fin d) (Fin d) Complex)
    (hH : ComplexPosDef (hermitianImaginaryPart H))
    (V : (Fin d -> Real) -> Complex) (a : iota -> (Fin d -> Real) -> Complex)
    {KV : Real} {Ka : iota -> Real}
    (hV : Continuous V) (ha : ∀ j, Continuous (a j))
    (hVb : ∀ z, ‖V z‖ ≤ KV) (hab : ∀ j z, ‖a j z‖ ≤ Ka j)
    (hprod : (∏ j, a j 0) ≠ 0)
    (hconst : (∫ w : Fin d -> Real, Complex.exp (Complex.I * phaseValue H w)) ≠ 0)
    (boundary : Real -> Complex)
    (hbdry : Filter.Tendsto boundary Filter.atTop (nhds 0))
    (hid : ∀ rho : Real,
      ((Real.sqrt rho ^ d : Real)) • (∫ z : Fin d -> Real,
          quadraticKernel H rho z * (V z * ∏ j, a j z)) = boundary rho) :
    V 0 = 0 :=
  riccatiRecovery_coefficient_eq_zero H hH V a hV ha hVb hab hprod hconst
    boundary hbdry hid

/-- Non-vacuity of the assembled recovery's constant: for the model phase
Hessian `i * Id` the complex Gaussian constant is the computed number
`sqrt(pi)^d`, which is nonzero. -/
theorem gaussianPhaseCoercivityVerificationBundle_modelConstant (d : Nat) :
    (∫ w : Fin d -> Real, Complex.exp (Complex.I *
        phaseValue ((Complex.I : Complex) • (1 : Matrix (Fin d) (Fin d) Complex)) w))
