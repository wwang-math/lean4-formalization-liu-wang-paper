    (hAccessible : ∀ t, P.ux t xMax = 0) :
    (∫ t in (0 : Real)..timeHorizon, ∫ x in xMin..xMax, P.greenIntegrand mu t x)
      = ∫ t in (0 : Real)..timeHorizon, P.ux t xMin * P.v t xMin :=
  P.greenIdentity_inaccessible mu hDirichletMin hDirichletMax hAccessible

/-- Generated certificate of the full spacetime Green identity. -/
def spacetimeGreenVerificationBundle
    (P : SlabWavePair timeHorizon xMin xMax) (mu : Complex) :
