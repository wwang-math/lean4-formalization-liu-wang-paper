rate `rho^{-(m + d/4)}`. -/
theorem gaussianL2BridgeVerificationBundle_beamRate
    {d : Nat} {phi a : (Fin d -> Real) -> Complex} {A b rho : Real} {m : Nat}
    (hA : 0 ≤ A) (hb : 0 < b) (hrho : 0 < rho)
    (hIm : ∀ z, b * radiusSq z ≤ (phi z).im)
    (ha : ∀ z, ‖a z‖ ≤ A * (radiusSq z) ^ m) :
    Real.sqrt (∫ z : Fin d -> Real,
        ‖Complex.exp (Complex.I * (rho : Complex) * phi z) * a z‖ ^ 2)
      ≤ A * rho ^ (-((m : Real) + (d : Real) / 4))
        * Real.sqrt (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d (2 * m) (2 * b)) :=
  beamProfile_L2_rate_of_beam hA hb hrho hIm ha

/-- Non-vacuity: the constant in the exported rate is a computed, strictly
positive number, and a concrete beam attains the hypotheses. -/
theorem gaussianL2BridgeVerificationBundle_nonVacuous
    {d : Nat} {b : Real} (hb : 0 < b) :
    LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d 0 (2 * b)
        = Real.sqrt (Real.pi / (2 * b)) ^ d ∧
      0 < Real.sqrt (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d 0 (2 * b)) :=
  ⟨gaussianMoment_zero d (by linarith), gaussianWitness_constant_pos hb⟩

/-- Paper-dossier export of the multiplicativity of profile bounds: the
Gaussian widths add and so do the transverse weights.  This is the bookkeeping
that turns four individual beam bounds into a bound on their product. -/
theorem gaussianL2BridgeVerificationBundle_widthsAdd
    {d : Nat} {f g : (Fin d -> Real) -> Complex} {C₁ C₂ : Real} {m₁ m₂ : Nat}
    {w₁ w₂ : Real}
    (hf : GaussianProfileBound f C₁ m₁ w₁) (hg : GaussianProfileBound g C₂ m₂ w₂) :
    GaussianProfileBound (fun z => f z * g z) (C₁ * C₂) (m₁ + m₂) (w₁ + w₂) :=
  hf.mul hg

/-- **Paper-dossier export of the four-beam interaction rate.**  The source's
interaction integrand `u^0 u^1 u^2 u^3` -- four Gaussian beams multiplied before
integration -- has transverse `L^2` norm of order
`rho^{-(m_0 + m_1 + m_2 + m_3 + d/4)}`, with the coercivity constants of the four
phases adding.  Nothing here is postulated: the rate is inherited from the four
individual pointwise profile bounds. -/
theorem gaussianL2BridgeVerificationBundle_fourBeamProduct
    {d : Nat} (f : Fin 4 -> (Fin d -> Real) -> Complex) (C : Fin 4 -> Real)
    (m : Fin 4 -> Nat) (b : Fin 4 -> Real) {rho : Real}
    (hC : 0 ≤ ∏ j, C j) (hb : 0 < ∑ j, b j) (hrho : 0 < rho)
    (h : ∀ j, GaussianProfileBound (f j) (C j) (m j) (b j * rho)) :
    Real.sqrt (∫ z : Fin d -> Real, ‖∏ j, f j z‖ ^ 2)
      ≤ (∏ j, C j) * rho ^ (-(((∑ j, m j : Nat) : Real) + (d : Real) / 4))
        * Real.sqrt
            (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d
              (2 * ∑ j, m j) (2 * ∑ j, b j)) :=
  fourBeamProduct_L2_rate f C m b hC hb hrho h

/-- Paper-dossier export of the reflection invariance of the Gaussian profile:
specular reflection of the transverse Fermi coordinate normal to the
inaccessible face is an isometry of the transverse slice, so the reflected beam
obeys the incident beam's pointwise bound verbatim. -/
theorem gaussianL2BridgeVerificationBundle_reflectionInvariance
    {d : Nat} {f : (Fin d -> Real) -> Complex} {C : Real} {m : Nat} {w : Real}
    (i0 : Fin d) (hf : GaussianProfileBound f C m w) :
    GaussianProfileBound (fun z => f (reflect i0 z)) C m w :=
  hf.comp_reflect i0

/-- Paper-dossier export of the Dirichlet property of the source's reflected
beam: the incident-minus-reflected combination vanishes identically on the
reflecting face. -/
theorem gaussianL2BridgeVerificationBundle_reflectedDirichlet
    {d : Nat} {i0 : Fin d} (f : (Fin d -> Real) -> Complex) {z : Fin d -> Real}
    (hz : z i0 = 0) : f z - f (reflect i0 z) = 0 :=
  reflectedDifference_eq_zero_on_face f hz

/-- **Paper-dossier export of the reflected-beam boundary rate.**  The reflected
combination obeys the source's transverse `L^2` rate with the exponent unchanged
and the constant merely doubled. -/
theorem gaussianL2BridgeVerificationBundle_reflectedRate
    {d : Nat} {f : (Fin d -> Real) -> Complex} {C : Real} {m : Nat} {b rho : Real}
    (i0 : Fin d) (hC : 0 ≤ C) (hb : 0 < b) (hrho : 0 < rho)
    (hf : GaussianProfileBound f C m (b * rho)) :
    Real.sqrt (∫ z : Fin d -> Real, ‖f z - f (reflect i0 z)‖ ^ 2)
      ≤ (C + C) * rho ^ (-((m : Real) + (d : Real) / 4))
        * Real.sqrt
            (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d (2 * m) (2 * b)) :=
  reflectedDifference_L2_rate i0 hC hb hrho hf

/-- **Paper-dossier export of the Gaussian-beam remainder rate.**  After the
WKB cancellation of `LiuWang2025SemilinearWaveWKBResidual` the residual is
`rho^{-N}` times a beam carrying the terminal jet; its transverse `L^2` norm is
`O(rho^{-(N + m + d/4)})`.  The frequency gain and the Gaussian width gain are
both computed. -/
theorem gaussianL2BridgeVerificationBundle_remainderRate
    {d : Nat} {phi a : (Fin d -> Real) -> Complex} {A b rho : Real} {m N : Nat}
    (hA : 0 ≤ A) (hb : 0 < b) (hrho : 0 < rho)
    (hIm : ∀ z, b * radiusSq z ≤ (phi z).im)
    (ha : ∀ z, ‖a z‖ ≤ A * (radiusSq z) ^ m) :
    Real.sqrt (∫ z : Fin d -> Real,
        ‖((rho : Complex) ^ N)⁻¹
          * (Complex.exp (Complex.I * (rho : Complex) * phi z) * a z)‖ ^ 2)
      ≤ A * Real.sqrt
            (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d (2 * m) (2 * b))
        * rho ^ (-(N : Real) - (m : Real) - (d : Real) / 4) :=
  beamRemainder_L2_rate hA hb hrho hIm ha

/-- Paper-dossier export of the norm comparison.  A profile bound written with
the ambient supremum norm of the transverse slice becomes one written with the
Euclidean radius, at the cost of dividing the Gaussian width by the
dimension. -/
theorem gaussianL2BridgeVerificationBundle_normComparison
    {d : Nat} {f : (Fin d -> Real) -> Complex} {C w : Real} {m : Nat}
    (hd : 0 < d) (hC : 0 ≤ C) (hw : 0 ≤ w)
    (hf : ∀ z, ‖f z‖ ≤ C * (‖z‖ ^ 2) ^ m * Real.exp (-w * ‖z‖ ^ 2)) :
    GaussianProfileBound f C m (w / (d : Real)) :=
  profileBound_of_normBound hd hC hw hf

/-- **Paper-dossier export of the `L^1` rate.**  The same pointwise profile
bound that produces the boundary `L^2` rate produces the interaction-integral
rate `rho^{-(m + d/2)}`: the Gaussian width buys a full `d/2` in `L^1` and only
`d/4` in `L^2`. -/
theorem gaussianL2BridgeVerificationBundle_interactionRate
    {d : Nat} {f : (Fin d -> Real) -> Complex} {C : Real} {m : Nat} {b rho : Real}
    (hb : 0 < b) (hrho : 0 < rho) (hf : GaussianProfileBound f C m (b * rho)) :
    ‖∫ z : Fin d -> Real, f z‖
      ≤ C * (rho ^ (-((m : Real) + (d : Real) / 2))
        * LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d m b) :=
  norm_integral_le_of_profileBound hb hrho hf

/-- **Paper-dossier export of the weighted four-beam interaction decay.**  The
source's interaction integral of the unknown coefficient against the product of
the four Gaussian beams is `O(rho^{-(m_0 + m_1 + m_2 + m_3 + d/2)})`, with the
coefficient entering only through its sup bound and the four coercivity
constants adding. -/
theorem gaussianL2BridgeVerificationBundle_weightedInteraction
    {d : Nat} (W : (Fin d -> Real) -> Complex)
    (f : Fin 4 -> (Fin d -> Real) -> Complex) (K : Real) (C : Fin 4 -> Real)
    (m : Fin 4 -> Nat) (b : Fin 4 -> Real) {rho : Real}
    (hW : ∀ z, ‖W z‖ ≤ K) (hb : 0 < ∑ j, b j) (hrho : 0 < rho)
    (h : ∀ j, GaussianProfileBound (f j) (C j) (m j) (b j * rho)) :
    ‖∫ z : Fin d -> Real, W z * ∏ j, f j z‖
      ≤ K * (∏ j, C j)
        * (rho ^ (-(((∑ j, m j : Nat) : Real) + (d : Real) / 2))
          * LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d
              (∑ j, m j) (∑ j, b j)) :=
  weightedFourBeamInteraction_bound W f K C m b hW hb hrho h

/-- **Paper-dossier export: the beam-substitution remainder vanishes.**
`LiuWang2025SemilinearWaveEquation44RateRobustRecovery` recovers the unknown
coefficient from equation (4.4) using only that the beam-substitution remainder
tends to zero.  That hypothesis is now *supplied* by the quantitative Gaussian
estimates above: a weighted four-beam interaction integral with profile bounds
uniform in the frequency decays like `rho^{-(sum m_j + d/2)}`, hence to zero. -/
theorem gaussianL2BridgeVerificationBundle_remainderVanishes
    {d : Nat} (W : (Fin d -> Real) -> Complex)
    (u : Real -> Fin 4 -> (Fin d -> Real) -> Complex)
    (K : Real) (C : Fin 4 -> Real) (m : Fin 4 -> Nat) (b : Fin 4 -> Real)
    (hd : 0 < d) (hW : ∀ z, ‖W z‖ ≤ K) (hb : 0 < ∑ j, b j)
    (hu : ∀ rho : Real, 0 < rho ->
      ∀ j, GaussianProfileBound (u rho j) (C j) (m j) (b j * rho)) :
    Filter.Tendsto (fun rho : Real => ∫ z : Fin d -> Real, W z * ∏ j, u rho j z)
      Filter.atTop (nhds 0) :=
  weightedFourBeamInteraction_tendsto_zero W u K C m b hd hW hb hu

/-- **Paper-dossier export of the Sobolev-order bookkeeping.**  If the `k`-th
transverse derivative jet of the beam obeys a profile bound with constant
`A k * rho^k` -- one frequency power per derivative -- then for `rho >= 1` the
whole Sobolev sum of transverse `L^2` norms is `O(rho^{K - m - d/4})`. -/
theorem gaussianL2BridgeVerificationBundle_sobolevOrder
    {d K : Nat} (u : Fin (K + 1) -> (Fin d -> Real) -> Complex)
    (A : Fin (K + 1) -> Real) {m : Nat} {b rho : Real}
    (hA : ∀ k, 0 ≤ A k) (hb : 0 < b) (hrho : 1 ≤ rho)
    (hu : ∀ k : Fin (K + 1),
      GaussianProfileBound (u k) (A k * rho ^ (((k : Nat) : Real))) m (b * rho)) :
    (∑ k, Real.sqrt (∫ z : Fin d -> Real, ‖u k z‖ ^ 2))
      ≤ (∑ k, A k)
        * Real.sqrt
            (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d (2 * m) (2 * b))
        * rho ^ ((K : Real) - (m : Real) - (d : Real) / 4) :=
  sobolevSum_L2_rate u A hA hb hrho hu

/-- Paper-dossier export of the arbitrary-weight rate.  The source's reflected
beam carries the transverse weight `|y|^{N+1-j+k}`, whose parity is not fixed;
squaring a `|z|^p` bound produces the natural power `(|z|^2)^p`, so the moment
scaling applies and the rate is `rho^{-(p/2 + d/4)}`. -/
theorem gaussianL2BridgeVerificationBundle_arbitraryWeight
    {d : Nat} {f : (Fin d -> Real) -> Complex} {C : Real} {p : Nat} {b rho : Real}
    (hC : 0 ≤ C) (hb : 0 < b) (hrho : 0 < rho)
    (hf : RadiusProfileBound f C p (b * rho)) :
    Real.sqrt (∫ z : Fin d -> Real, ‖f z‖ ^ 2)
      ≤ C * rho ^ (-((p : Real) / 2 + (d : Real) / 4))
        * Real.sqrt
            (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d p (2 * b)) :=
  sqrt_integral_normSq_le_of_radiusProfileBound hC hb hrho hf

/-- **Paper-dossier export of the source's displayed reflected-boundary rate.**
Subsection 3.2 bounds the tangential derivatives of the reflected beam on the
reflecting face by `C sum_{k+j=|alpha|} rho^k |y|^k e^{-C' rho |y|^2}|y|^{N+1-j}`
and concludes `|| v_rho ||_{H^k(R_1)} <= C rho^{-(N-k+1)/2 - 3/4}`.  That is the
statement below: the displayed `3/4` is the computed Gaussian `d/4` at `d = 3`,
and the frequency powers and transverse weights combine so that only `|alpha|`
survives in the exponent. -/
theorem gaussianL2BridgeVerificationBundle_sourceReflectedBoundary
    (N alpha : Nat) (v : Nat -> (Fin 3 -> Real) -> Complex) (A : Nat -> Real)
    {b rho : Real} (halpha : alpha ≤ N + 1) (hA : ∀ k, 0 ≤ A k)
    (hb : 0 < b) (hrho : 0 < rho)
    (hv : ∀ k ∈ Finset.range (alpha + 1),
      RadiusProfileBound (v k) (A k * rho ^ (k : Real))
        (k + (N + 1 - (alpha - k))) (b * rho)) :
    (∑ k ∈ Finset.range (alpha + 1),
        Real.sqrt (∫ z : Fin 3 -> Real, ‖v k z‖ ^ 2))
      ≤ (∑ k ∈ Finset.range (alpha + 1),
            A k * Real.sqrt
              (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment 3
                (k + (N + 1 - (alpha - k))) (2 * b)))
        * rho ^ (-(((N : Real) - (alpha : Real) + 1) / 2) - 3 / 4) :=
  reflectedBoundary_source_rate N alpha v A halpha hA hb hrho hv

/-- **Paper-dossier export of the inaccessible-boundary term.**  This is the
crux of the partial-data argument: the term of equation (4.3) over
`Sigma \ Gamma`, which the measurement set does not see, is a pairing of a
fixed finite-`L^2`-mass normal-derivative jump against a reflected beam whose
`L^2` mass decays at a positive rate.  The source estimates it by
Cauchy--Schwarz; balancing the elementary inequality
`ab <= (t/2)a^2 + (1/(2t))b^2` at `t = rho^{-E}` reproduces that rate exactly,
and the term tends to zero. -/
theorem gaussianL2BridgeVerificationBundle_inaccessibleBoundary
    {d : Nat} (F : (Fin d -> Real) -> Complex)
    (w : Real -> (Fin d -> Real) -> Complex) {P Cw E : Real} (hE : 0 < E)
    (hF : MeasureTheory.Integrable (fun z : Fin d -> Real => ‖F z‖ ^ 2))
    (hFP : (∫ z : Fin d -> Real, ‖F z‖ ^ 2) ≤ P)
    (hw : ∀ rho : Real, 0 < rho ->
      MeasureTheory.Integrable (fun z : Fin d -> Real => ‖w rho z‖ ^ 2))
    (hwQ : ∀ rho : Real, 0 < rho ->
      (∫ z : Fin d -> Real, ‖w rho z‖ ^ 2) ≤ Cw ^ 2 * rho ^ (-(2 * E))) :
    Filter.Tendsto (fun rho : Real => ∫ z : Fin d -> Real, F z * w rho z)
      Filter.atTop (nhds 0) :=
  inaccessiblePairing_tendsto_zero F w hE hF hFP hw hwQ

/-- **Paper-dossier export of the source's normalization.**  Subsection 4.2
multiplies the integral identity by `rho^{(n+1)/2}` before passing to the limit.
In spacetime dimension `d = 1 + n` the interaction integral carries exactly
`rho^{-d/2}`, so the normalized quantity is bounded uniformly in `rho >= 1` and
the stationary-phase limit is finite.  The normalization is therefore computed,
not chosen. -/
theorem gaussianL2BridgeVerificationBundle_normalizedInteraction
    {d : Nat} (W : (Fin d -> Real) -> Complex)
    (f : Fin 4 -> (Fin d -> Real) -> Complex) (K : Real) (C : Fin 4 -> Real)
    (m : Fin 4 -> Nat) (b : Fin 4 -> Real) {rho : Real}
    (hW : ∀ z, ‖W z‖ ≤ K) (hb : 0 < ∑ j, b j) (hrho : 1 ≤ rho)
    (hCnn : 0 ≤ ∏ j, C j)
    (h : ∀ j, GaussianProfileBound (f j) (C j) (m j) (b j * rho)) :
    rho ^ ((d : Real) / 2) * ‖∫ z : Fin d -> Real, W z * ∏ j, f j z‖
      ≤ K * (∏ j, C j)
        * LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d
            (∑ j, m j) (∑ j, b j) :=
  normalized_interaction_bounded W f K C m b hW hb hrho hCnn h

/-- **Paper-dossier export of the source's point recovery.**  This is the
endpoint of Subsection 4.2: in the identity (4.3) the left-hand side converges
to a nonzero multiple of the coefficient at the interaction point, while the
term over the inaccessible face converges to zero, so the coefficient vanishes
there.  The boundary limit is *not* a hypothesis of the packet -- it is derived
from the reflected-beam `L^2` rate.  What remains a hypothesis is the
stationary-phase convergence of the principal term. -/
theorem gaussianL2BridgeVerificationBundle_pointRecovery
    {d : Nat} (D : ReflectedBeamPointRecovery d) : D.coefficient = 0 :=
  D.coefficient_eq_zero

/-- The inaccessible-boundary limit inside that packet, as a theorem. -/
theorem gaussianL2BridgeVerificationBundle_pointRecoveryBoundary
    {d : Nat} (D : ReflectedBeamPointRecovery d) :
    Filter.Tendsto
      (fun rho : Real => ∫ z : Fin d -> Real, D.trace z * D.beam rho z)
      Filter.atTop (nhds 0) :=
  D.boundary_tendsto_zero

/-- Non-vacuity: the packet is inhabited, with a trace that vanishes nowhere. -/
theorem gaussianL2BridgeVerificationBundle_pointRecoveryNonVacuous (d : Nat) :
    ∀ z : Fin d -> Real, (witnessPointRecovery d).trace z ≠ 0 :=
  witnessPointRecovery_trace_ne_zero d

/-- **Paper-dossier export of the source's normalization as an identity.**  The
change of variables `z = rho^{-1/2} w` converts the frequency-scaled Gaussian
integral into a fixed one with the amplitude sampled at shrinking scale.  The
prefactor `(sqrt rho)^d` is the source's `rho^{(n+1)/2}`, and the statement is
an exact identity, not an asymptotic one. -/
theorem gaussianL2BridgeVerificationBundle_rescaling
    {d : Nat} (g : (Fin d -> Real) -> Complex) {b rho : Real} (hrho : 0 < rho) :
    ((Real.sqrt rho ^ d : Real)) • (∫ y : Fin d -> Real,
        g y * ((Real.exp (-(b * rho) * radiusSq y) : Real) : Complex))
      = ∫ w : Fin d -> Real,
          g ((Real.sqrt rho)⁻¹ • w)
            * ((Real.exp (-b * radiusSq w) : Real) : Complex) :=
  rescaled_gaussian_integral g hrho

/-- **Paper-dossier export of the stationary-phase limit.**  Subsection 4.2
invokes Hoermander 7.7.5.  For the Gaussian weight the Riccati construction
actually produces, the mechanism is the exact rescaling above followed by
dominated convergence, and the limit is the amplitude at the beam centre times
the computed, strictly positive constant `sqrt(pi/b)^d`. -/
theorem gaussianL2BridgeVerificationBundle_stationaryPhase
    {d : Nat} (g : (Fin d -> Real) -> Complex) {A b : Real}
    (hg : Continuous g) (hA : ∀ z, ‖g z‖ ≤ A) (hb : 0 < b) :
    Filter.Tendsto
      (fun rho : Real => ((Real.sqrt rho ^ d : Real)) • ∫ y : Fin d -> Real,
          g y * ((Real.exp (-(b * rho) * radiusSq y) : Real) : Complex))
      Filter.atTop
      (nhds (g 0 * ((Real.sqrt (Real.pi / b) ^ d : Real) : Complex))) :=
  tendsto_normalized_gaussian_integral g hg hA hb

/-- **Paper-dossier export of the source's pointwise conclusion.**  With the
Gaussian weight, both limits in Subsection 4.2 are theorems: the normalized
left-hand side converges to the amplitude at the interaction point times a
strictly positive constant, and the boundary side vanishes by the reflected-beam
estimate.  Hence `V_3(p~) = 0`, with no stationary-phase hypothesis. -/
theorem gaussianL2BridgeVerificationBundle_pointwiseVanishing
    {d : Nat} (g : (Fin d -> Real) -> Complex) {A b : Real}
    (hg : Continuous g) (hA : ∀ z, ‖g z‖ ≤ A) (hb : 0 < b)
    (boundary : Real -> Complex)
    (hbdry : Filter.Tendsto boundary Filter.atTop (nhds 0))
    (hid : ∀ rho : Real,
      ((Real.sqrt rho ^ d : Real)) • (∫ y : Fin d -> Real,
          g y * ((Real.exp (-(b * rho) * radiusSq y) : Real) : Complex))
        = boundary rho) :
    g 0 = 0 :=
  amplitude_eq_zero_of_gaussian_identity g hg hA hb boundary hbdry hid

/-- **Paper-dossier export of the source's pointwise recovery for the actual
interaction integrand.**  The amplitude in the source's identity is the unknown
coefficient times the product of the beam amplitudes.  Because the source's
geodesics meet only at the interaction point, that product is nonzero there, so
the coefficient itself vanishes -- the conclusion `V_3(p~) = 0` of Subsection
4.2, and, at a general finite index, the conclusion `V_m(p~) = 0` of Subsection
4.3. -/
theorem gaussianL2BridgeVerificationBundle_coefficientVanishing
    {d : Nat} {iota : Type} [Fintype iota] (V : (Fin d -> Real) -> Complex)
    (a : iota -> (Fin d -> Real) -> Complex) {KV b : Real} {Ka : iota -> Real}
    (hV : Continuous V) (ha : ∀ j, Continuous (a j))
    (hVb : ∀ z, ‖V z‖ ≤ KV) (hab : ∀ j z, ‖a j z‖ ≤ Ka j)
    (hprod : (∏ j, a j 0) ≠ 0) (hb : 0 < b)
    (boundary : Real -> Complex)
    (hbdry : Filter.Tendsto boundary Filter.atTop (nhds 0))
    (hid : ∀ rho : Real,
      ((Real.sqrt rho ^ d : Real)) • (∫ y : Fin d -> Real,
          (V y * ∏ j, a j y)
            * ((Real.exp (-(b * rho) * radiusSq y) : Real) : Complex))
        = boundary rho) :
    V 0 = 0 :=
  coefficient_eq_zero_of_gaussian_identity V a hV ha hVb hab hprod hb
    boundary hbdry hid

/-- Generated certificate of the pointwise-to-`L^2` bridge. -/
def gaussianL2BridgeVerificationBundle (d : Nat) (b rho : Real) :
    LiuWang2025SemilinearWaveGaussianL2Bridge.Certificate d b rho :=
  LiuWang2025SemilinearWaveGaussianL2Bridge.certificate d b rho

end GaussianL2Bridge

/-! ## Uniform Gaussian coercivity from the Riccati phase -/

section GaussianPhaseCoercivity

open LiuWang2025SemilinearWaveGaussianPhaseCoercivity
open LiuWang2025SemilinearWaveGaussianMassScaling (radiusSq)
open LiuWang2025SemilinearWaveRiccatiPhase (ComplexPosDef hermitianImaginaryPart)

/-- Paper-dossier export of the compactness step.  A continuous quadratic
homogeneous form which is strictly positive away from the origin is bounded
below by a positive multiple of the transverse radius, *uniformly*: the
constant is obtained by minimisation on the compact transverse unit sphere. -/
theorem gaussianPhaseCoercivityVerificationBundle_homogeneous
    {d : Nat} {Q : (Fin d -> Real) -> Real} (hQc : Continuous Q)
    (hhom : ∀ (r : Real) (z : Fin d -> Real), Q (r • z) = r ^ 2 * Q z)
    (hpos : ∀ z : Fin d -> Real, z ≠ 0 -> 0 < Q z) :
    ∃ b : Real, 0 < b ∧ ∀ z : Fin d -> Real, b * radiusSq z ≤ Q z :=
  exists_coercivity_of_pos hQc hhom hpos

/-- **Paper-dossier export of the Riccati-to-Gaussian bridge.**  The pointwise
positivity `0 < Im (x^* H x)` proved in the Riccati layer upgrades to the
uniform transverse coercivity `b |z|^2 <= Im phi_H(z)` required by the Gaussian
beam bounds. -/
theorem gaussianPhaseCoercivityVerificationBundle_riccati
    {d : Nat} (H : Matrix (Fin d) (Fin d) Complex)
    (hH : ComplexPosDef (hermitianImaginaryPart H)) :
    ∃ b : Real, 0 < b ∧
      ∀ z : Fin d -> Real, b * radiusSq z ≤ (phaseValue H z).im :=
  exists_riccatiPhase_coercivity H hH

/-- **Paper-dossier export of the end-to-end beam rate.**  A Gaussian beam
built on a Riccati-transported phase Hessian, with amplitude dominated by
`A |z|^{2m}`, has transverse `L^2` norm `O(rho^{-(m + d/4)})`.  No coercivity
hypothesis appears: it is produced from the Riccati positivity. -/
theorem gaussianPhaseCoercivityVerificationBundle_beamRate
    {d : Nat} (H : Matrix (Fin d) (Fin d) Complex)
    (hH : ComplexPosDef (hermitianImaginaryPart H))
    {a : (Fin d -> Real) -> Complex} {A rho : Real} {m : Nat}
    (hA : 0 ≤ A) (hrho : 0 < rho)
    (ha : ∀ z, ‖a z‖ ≤ A * (radiusSq z) ^ m) :
    ∃ b : Real, 0 < b ∧
      Real.sqrt (∫ z : Fin d -> Real,
          ‖Complex.exp (Complex.I * (rho : Complex) * phaseValue H z) * a z‖ ^ 2)
        ≤ A * rho ^ (-((m : Real) + (d : Real) / 4))
          * Real.sqrt
              (LiuWang2025SemilinearWaveGaussianL2Bridge.gaussianMoment d (2 * m) (2 * b)) :=
  riccatiBeam_L2_rate H hH hA hrho ha

/-- Non-vacuity: the model phase Hessian `i * Id` satisfies the Riccati
positivity hypothesis, so the coercivity chain is inhabited. -/
theorem gaussianPhaseCoercivityVerificationBundle_nonVacuous (d : Nat) :
    hermitianImaginaryPart
