than assumed of an abstract phase. -/
theorem chartBeamVerificationBundle_constructedPhaseCoercivity {n : Nat}
    (H : Fin n -> Fin n -> Complex) (c : Complex) {bcoer : Real} (hc : 0 ≤ c.im)
