/-- Paper-dossier export of the exchange of the `t` and `x` integrations for a
jointly continuous spacetime integrand: the step that fuses the temporal and
spatial halves of the Lorentzian Green identity. -/
theorem spacetimeGreenVerificationBundle_fubini
    {F : Real -> Real -> Complex} (hF : Continuous (Function.uncurry F))
    {a b c d : Real} (hab : a <= b) (hcd : c <= d) :
    (∫ t in a..b, ∫ x in c..d, F t x) = ∫ x in c..d, ∫ t in a..b, F t x :=
  swap_intervalIntegral hF hab hcd

/-- **Paper-dossier export of equations (4.2)--(4.3) on the concrete slab
core.**  The temporal half is two integrations by parts against the source's
directed Cauchy data, the spatial half is Green's second identity with the
lateral normal-trace flux, and Fubini fuses them. -/
theorem spacetimeGreenVerificationBundle_identity
    (P : SlabWavePair timeHorizon xMin xMax) (mu : Complex) :
    (∫ t in (0 : Real)..timeHorizon, ∫ x in xMin..xMax, P.greenIntegrand mu t x)
      = -∫ t in (0 : Real)..timeHorizon,
          lateralFlux (P.u t) (P.ux t) (P.v t) (P.vx t) xMin xMax :=
  P.greenIdentity mu

/-- Equation (4.3) itself: after the homogeneous lateral Dirichlet condition
and the accessible-face cancellation, one inaccessible-boundary term
remains. -/
theorem spacetimeGreenVerificationBundle_inaccessible
    (P : SlabWavePair timeHorizon xMin xMax) (mu : Complex)
