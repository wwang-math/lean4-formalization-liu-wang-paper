    (data : LiuWang2025SemilinearWaveRiccatiExistence.Coefficients n)
    {t : Real} (ht : t ∈ Set.uIcc data.startTime data.endTime) :
    RiccatiGeneratedTransport.traceTransportCoefficient data t =
      Matrix.trace (data.C t * data.toRiccatiFlow.H t) :=
  RiccatiGeneratedTransport.traceTransportCoefficient_eq_trace_CH data ht

/-- Dossier export for the exact source-sign leading-amplitude equation driven
by the generated `Tr(C H)` coefficient. -/
theorem riccatiGeneratedLeadingTransportVerificationBundle_equation
    (data : LiuWang2025SemilinearWaveRiccatiExistence.Coefficients n)
    (initial : Complex) {t : Real}
