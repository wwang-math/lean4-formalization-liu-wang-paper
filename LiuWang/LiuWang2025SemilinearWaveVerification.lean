  LiuWang2025SemilinearWavePhaseUpdate.exists_phase_cancelling_upto base hbase t0
    hquad N

/-! ## Degree two: the Riccati step, treated separately -/

/-- **The Riccati nonlinearity is absent above degree two.**  The quadratic
self-interaction of a degree-`r` perturbation cannot reach degree `r` once
`r >= 3`, which is exactly why degree two needs its own equation. -/
theorem phaseUpdateVerificationBundle_noRiccatiAboveTwo {d : Nat}
    (Att : Fin d -> Fin d
      -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    {delta : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d} {r : Nat}
    {s : Real} (hr : 3 ≤ r)
    (hdelta : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≠ r
      -> delta.c b s = 0)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d}
    (ha : LiuWang2025SemilinearWaveTransverseJet.deg a = r) :
    LiuWang2025SemilinearWaveSameDegreeMatrix.quadraticSelfTerm Att delta a s
      = 0 :=
  LiuWang2025SemilinearWaveSameDegreeMatrix.quadraticSelfTerm_eq_zero_of_three_le
    Att hr hdelta ha

/-- **The degree-two eikonal in Riccati form.**  Base eikonal, twice the
longitudinal derivative of the quadratic block, the linear same-degree operator
built from the base phase, and the quadratic Riccati term. -/
theorem phaseUpdateVerificationBundle_degreeTwoRiccatiForm {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (P base : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (s : Real) (alpha : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2)
    (hlow : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b < 2
      -> P.phi.c b s = base.phi.c b s)
    (hdlow : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b < 2
      -> P.dphi.c b s = base.dphi.c b s)
    (hoff : ∀ b, 2 < LiuWang2025SemilinearWaveTransverseJet.deg b
      -> P.phi.c b s = base.phi.c b s) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att P.phi
        P.dphi alpha.1 s
      = LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att
            base.phi base.dphi alpha.1 s
        + 2 * (P.dphi.c alpha.1 s - base.dphi.c alpha.1 s)
        + ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2,
            LiuWang2025SemilinearWaveSameDegreeMatrix.phaseEikonalMatrix base 2 s
                alpha beta
              * (P.phi.c beta.1 s - base.phi.c beta.1 s)
        + LiuWang2025SemilinearWaveSameDegreeMatrix.quadraticSelfTerm G.Att
            (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.sub P.phi base.phi)
            alpha.1 s :=
  LiuWang2025SemilinearWaveSameDegreeMatrix.eikonal_deg_two_riccati_form P base s
    alpha hlow hdlow hoff

/-- **The Riccati term is a genuine quadratic form** whose coefficients come
from the metric alone -- the repository's form of the source's `H C H`. -/
theorem phaseUpdateVerificationBundle_riccatiQuadraticForm {d : Nat}
    (Att : Fin d -> Fin d
      -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (delta : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d) (r : Nat)
    (s : Real)
    (hsupp : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≠ r
      -> delta.c b s = 0)
    (alpha : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r) :
    LiuWang2025SemilinearWaveSameDegreeMatrix.quadraticSelfTerm Att delta
        alpha.1 s
      = ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
          (∑ gamma : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
            LiuWang2025SemilinearWaveSameDegreeMatrix.riccatiTensor Att r alpha
                beta gamma s
              * delta.c gamma.1 s)
          * delta.c beta.1 s :=
  LiuWang2025SemilinearWaveSameDegreeMatrix.quadraticSelfTerm_matrix Att delta r
    s hsupp alpha

/-- **The Riccati-derivative / `quadCoeff`-derivative correspondence.** -/
theorem phaseUpdateVerificationBundle_quadCoeffDerivative {d : Nat}
    (M M' : Real -> Fin d -> Fin d -> Complex)
    (hM : ∀ p q s, HasDerivAt (fun t => M t p q) (M' s p q) s)
    (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real) :
    HasDerivAt (fun t => LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M t) a)
      (LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M' s) a) s :=
  LiuWang2025SemilinearWaveDegreeBlock.hasDerivAt_quadCoeff M M' hM a s

/-- **The degree-two phase, built from a Riccati matrix.**  Given a matrix
solving the coefficient form of the source's Riccati equation on the paper
interval, the quadratic phase `z^T M(s) z` is inserted and *every* degree-two
coefficient of the actual `jetEikonal` is proved to vanish. -/
theorem phaseUpdateVerificationBundle_degreeTwoPhase {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (base : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (hbase : LiuWang2025SemilinearWavePhaseUpdate.C1Data G base)
    {lo hi : Real} (M M' M'' : Real -> Fin d -> Fin d -> Complex)
    (hM : ∀ p q s, HasDerivAt (fun t => M t p q) (M' s p q) s)
    (hM' : ∀ p q s, HasDerivAt (fun t => M' t p q) (M'' s p q) s)
    (hM''cont : ∀ p q, Continuous fun s => M'' s p q)
    (hric : ∀ s ∈ Set.Icc lo hi,
      ∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2,
        2 * LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M' s) a.1
            + ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2,
                LiuWang2025SemilinearWaveSameDegreeMatrix.phaseEikonalMatrix base
                    2 s a beta
                  * LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M s) beta.1
            + LiuWang2025SemilinearWaveSameDegreeMatrix.quadraticSelfTerm G.Att
                (LiuWang2025SemilinearWaveDegreeBlock.quadJet M M' hM) a.1 s
          = LiuWang2025SemilinearWaveSameDegreeMatrix.phaseSource base 2 s a) :
    ∃ P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G,
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a ≠ 2 ->
          P.phi.c a s = base.phi.c a s) ∧
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a ≠ 2 ->
          P.dphi.c a s = base.dphi.c a s) ∧
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a = 2 ->
          P.phi.c a s = base.phi.c a s
            + LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M s) a) ∧
      LiuWang2025SemilinearWavePhaseUpdate.C1Data G P ∧
      (∀ s ∈ Set.Icc lo hi,
        ∀ a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d,
          LiuWang2025SemilinearWaveTransverseJet.deg a = 2 ->
            LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att
              P.phi P.dphi a s = 0) :=
  LiuWang2025SemilinearWavePhaseUpdate.exists_quadratic_phase_update base hbase M
    M' M'' hM hM' hM''cont hric

/-! ## The degree-two Riccati ODE, solved -/

/-- **The degree-two cancellation in the block form the Riccati ODE produces.**
Matrix, source and quadratic tensor are all built from the metric and the base
phase; the unknown appears only as the degree-two block. -/
theorem phaseUpdateVerificationBundle_degreeTwoBlockCancellation {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (P base : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (s : Real) (alpha : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2)
    (hlow : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b < 2
      -> P.phi.c b s = base.phi.c b s)
    (hdlow : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b < 2
      -> P.dphi.c b s = base.dphi.c b s)
    (hoff : ∀ b, 2 < LiuWang2025SemilinearWaveTransverseJet.deg b
      -> P.phi.c b s = base.phi.c b s)
    (hric : 2 * (P.dphi.c alpha.1 s - base.dphi.c alpha.1 s)
        + ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2,
            LiuWang2025SemilinearWaveSameDegreeMatrix.phaseEikonalMatrix base 2 s
                alpha beta
              * (P.phi.c beta.1 s - base.phi.c beta.1 s)
        + ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2,
            (∑ gamma : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2,
              LiuWang2025SemilinearWaveSameDegreeMatrix.riccatiTensor G.Att 2
                  alpha beta gamma s
                * (P.phi.c gamma.1 s - base.phi.c gamma.1 s))
            * (P.phi.c beta.1 s - base.phi.c beta.1 s)
      = LiuWang2025SemilinearWaveSameDegreeMatrix.phaseSource base 2 s alpha) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att P.phi
      P.dphi alpha.1 s = 0 :=
  LiuWang2025SemilinearWaveSameDegreeMatrix.eikonal_deg_two_eq_zero_of_blockRiccatiEquation
    P base s alpha hlow hdlow hoff hric

/-- **The clamped quadratic field is globally state-Lipschitz**, with a constant
produced from the row sums of the matrix and the coefficient sums of the
quadratic tensor -- which is what lets the repository's Picard iteration run on
a genuinely nonlinear equation. -/
theorem phaseUpdateVerificationBundle_riccatiLipschitz {d r : Nat}
    (K : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r -> Complex)
    (T : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r -> Complex)
    (source : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r)
    {R BK BT : Real} (hR : 0 ≤ R) (hBK : 0 ≤ BK) (hBT : 0 ≤ BT) (s : Real)
    (hKb : ∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
      ∑ b, ‖K s a b‖ ≤ BK)
    (hTb : ∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
      ∑ beta, ∑ gamma, ‖T s a beta gamma‖ ≤ BT) :
    LipschitzWith (Real.toNNReal (BK + 4 * R * BT))
      (LiuWang2025SemilinearWaveRiccatiODE.riccatiField K T source R s) :=
  LiuWang2025SemilinearWaveRiccatiODE.lipschitz_riccatiField K T source hR hBK
    hBT s hKb hTb

/-- **The actual quadratic Riccati equation is solved** on an explicit window
around the initial parameter.  The window length is produced by the proof; no
bound, Lipschitz constant or interval length is an assumption. -/
theorem phaseUpdateVerificationBundle_riccatiLocalExistence {d r : Nat}
    (K : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r -> Complex)
    (T : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r -> Complex)
    (source : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r)
    (hK : ∀ a b, Continuous fun s => K s a b)
    (hT : ∀ a b c, Continuous fun s => T s a b c)
    (hsrc : ∀ a, Continuous fun s => source s a)
    {lo hi : Real} (t0 : Set.Icc lo hi)
    (x0 : LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r) :
    ∃ (delta : Real)
      (c : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r),
      0 < delta ∧ c t0 = x0 ∧ Continuous c ∧
      ∀ t ∈ Set.Icc lo hi, |t - (t0 : Real)| ≤ delta ->
        HasDerivWithinAt c
          (fun a => ((2 : Complex))⁻¹ * (source t a - ∑ b, K t a b * c t b
            - ∑ beta, (∑ gamma, T t a beta gamma * c t gamma) * c t beta))
          (Set.Icc lo hi) t :=
  LiuWang2025SemilinearWaveRiccatiODE.exists_riccatiSolution K T source hK hT
    hsrc t0 x0

/-! ## The Riccati / transverse-jet phase bridge -/

section RiccatiBridge

open scoped Matrix.Norms.L2Operator

/-- **The exact degree-two gradient normalization.**  For an ordinary-monomial
quadratic phase `z^T M z` with `M` symmetric, the transverse gradient has
degree-one coefficients `2 M_{k i}` -- the diagonal picking up two from the
derivative and one from `quadCoeff`, the off-diagonal one from the derivative
and two from `quadCoeff`. -/
theorem riccatiBridgeVerificationBundle_gradientNormalization {d : Nat}
    (M M' : Real -> Fin d -> Fin d -> Complex)
    (hM : ∀ p q s, HasDerivAt (fun t => M t p q) (M' s p q) s)
    {s : Real} (hsymm : ∀ p q, M s p q = M s q p) (i k : Fin d) :
    (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.transverseDeriv i
        (LiuWang2025SemilinearWaveDegreeBlock.quadJet M M' hM)).c
      (Pi.single k 1) s = 2 * M s k i :=
  LiuWang2025SemilinearWaveRiccatiPhaseBridge.transverseDeriv_quadJet_single
    M M' hM hsymm i k

/-- **`D = (1/4) d_p d_q g^{11}`, proved.**  The degree-two coefficient family of
`A^{i1 i1}` is `quadCoeff (2 D)`. -/
theorem riccatiBridgeVerificationBundle_dNormalization {d : Nat}
    (G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d}
    (ha : LiuWang2025SemilinearWaveTransverseJet.deg a = 2) (s : Real) :
    (G.Att G.i1 G.i1).c a s
      = 2 * LiuWang2025SemilinearWaveDegreeBlock.quadCoeff
          (LiuWang2025SemilinearWaveRiccatiPhaseBridge.metricD G s) a :=
  LiuWang2025SemilinearWaveRiccatiPhaseBridge.metricD_spec G ha s

/-- **The degree-two linear block operator vanishes in Fermi coordinates**, which
is why degree two is a pure Riccati equation with no linear term. -/
theorem riccatiBridgeVerificationBundle_noLinearTerm {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    {C D : Real -> Fin d -> Fin d -> Complex}
    (hcompat : LiuWang2025SemilinearWaveRiccatiPhaseBridge.FermiCompat G C D)
    {base : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G}
    (hq : LiuWang2025SemilinearWaveRiccatiPhaseBridge.QuadFree base) (s : Real)
    (alpha beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2) :
    LiuWang2025SemilinearWaveSameDegreeMatrix.phaseEikonalMatrix base 2 s alpha
      beta = 0 :=
  LiuWang2025SemilinearWaveRiccatiPhaseBridge.phaseEikonalMatrix_base_eq_zero
    hcompat hq s alpha beta

/-- **The degree-two identity of the phase recursion, derived from equation
(3.8).**  It is not an input anywhere. -/
theorem riccatiBridgeVerificationBundle_degreeTwoIdentity {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    {C D : Real -> Fin d -> Fin d -> Complex}
    (hcompat : LiuWang2025SemilinearWaveRiccatiPhaseBridge.FermiCompat G C D)
    {base : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G}
    (hq : LiuWang2025SemilinearWaveRiccatiPhaseBridge.QuadFree base)
    (M M' : Real -> Fin d -> Fin d -> Complex)
    (hM : ∀ p q s, HasDerivAt (fun t => M t p q) (M' s p q) s)
    {s : Real} (hsymm : ∀ p q, M s p q = M s q p)
    (heq : ∀ p q, M' s p q
        + (∑ i, ∑ j, M s p i * C s i j * M s j q) + D s p q = 0)
    (alpha : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2) :
    2 * LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M' s) alpha.1
        + ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d 2,
            LiuWang2025SemilinearWaveSameDegreeMatrix.phaseEikonalMatrix base 2 s
                alpha beta
              * LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M s) beta.1
        + LiuWang2025SemilinearWaveSameDegreeMatrix.quadraticSelfTerm G.Att
            (LiuWang2025SemilinearWaveDegreeBlock.quadJet M M' hM) alpha.1 s
      = LiuWang2025SemilinearWaveSameDegreeMatrix.phaseSource base 2 s alpha :=
  LiuWang2025SemilinearWaveRiccatiPhaseBridge.hric_of_riccati hcompat hq M M' hM
    hsymm heq alpha

/-- **The whole finite-order phase, generated from metric and Riccati input
alone.**  No matrix path, degree-two identity, cancellation statement, final
phase or invertibility claim is an input; the degree-two block is the generated
Riccati matrix and is symmetric on the interval. -/
theorem riccatiBridgeVerificationBundle_finiteOrderPhase {d : Nat}
    (G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d)
    (hG : LiuWang2025SemilinearWaveRiccatiPhaseBridge.FermiQuadraticData G)
    (base : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (hbase : LiuWang2025SemilinearWavePhaseUpdate.C1Data G base)
    (hq : LiuWang2025SemilinearWaveRiccatiPhaseBridge.QuadFree base)
    {lower upper startTime endTime : Real}
    (hstart : startTime ∈ Set.Ioo lower upper)
    (hend : endTime ∈ Set.Ioo lower upper)
    (H0 : Matrix (Fin d) (Fin d) Complex) (hH0symm : H0.IsSymm)
    (hH0pos : LiuWang2025SemilinearWaveRiccatiPhase.ComplexPosDef
      (LiuWang2025SemilinearWaveRiccatiPhase.hermitianImaginaryPart H0))
    (t0 : Set.Icc (min startTime endTime) (max startTime endTime)) (N : Nat) :
    ∃ (M : Real -> Fin d -> Fin d -> Complex)
      (P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G),
      (∀ s ∈ Set.uIcc startTime endTime, M s
        = (LiuWang2025SemilinearWaveRiccatiPhaseBridge.toCoefficients G hG lower
            upper startTime endTime hstart hend H0 hH0symm
            hH0pos).toRiccatiFlow.H s) ∧
      (∀ s ∈ Set.uIcc startTime endTime, Matrix.IsSymm (M s)) ∧
      LiuWang2025SemilinearWavePhaseUpdate.C1Data G P ∧
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a ≤ 1 ->
          P.phi.c a s = base.phi.c a s) ∧
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a = 2 ->
          P.phi.c a s = base.phi.c a s
            + LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M s) a) ∧
      (∀ s ∈ Set.uIcc startTime endTime,
        ∀ a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d,
          LiuWang2025SemilinearWaveTransverseJet.deg a ≤ N ->
            LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att
              P.phi P.dphi a s = 0) :=
  LiuWang2025SemilinearWaveRiccatiPhaseBridge.exists_phase_from_riccati G hG base
    hbase hq hstart hend H0 hH0symm hH0pos t0 N

end RiccatiBridge

/-! ## Non-vacuity of the generated phase, and the amplitude jet operators -/

section AmplitudeAndExample

open scoped Matrix.Norms.L2Operator

/-- **The generated-phase endpoint is non-vacuous.**  An explicit transverse
dimension three Fermi jet with `C = diag(0,2,2)` and a nonzero real symmetric
`D` instantiates every hypothesis, and yields a symmetric, uniformly coercive
degree-two matrix together with a phase whose actual `jetEikonal` coefficients
vanish through any prescribed finite order. -/
theorem riccatiBridgeVerificationBundle_nonVacuousExample (N : Nat) :
    ∃ (M : Real -> Fin 3 -> Fin 3 -> Complex)
      (P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet
        LiuWang2025SemilinearWaveRiccatiPhaseExample.exMetric),
      (∀ s ∈ Set.uIcc (0 : Real) 1, M s
        = LiuWang2025SemilinearWaveRiccatiPhaseExample.exCoefficients.toRiccatiFlow.H s) ∧
      (∀ s ∈ Set.uIcc (0 : Real) 1, Matrix.IsSymm (M s)) ∧
      (∀ s ∈ Set.uIcc (0 : Real) 1, ∀ x : Fin 3 -> Complex,
        (1 / LiuWang2025SemilinearWaveRiccatiPhaseExample.exCoefficients.actionBound ^ 2)
            * ‖x‖ ^ 2
          ≤ (LiuWang2025SemilinearWaveRiccatiPhase.complexQuadratic (M s) x).im) ∧
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex 3) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a = 2 ->
          P.phi.c a s
            = LiuWang2025SemilinearWaveRiccatiPhaseExample.exBasePhase.phi.c a s
              + LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M s) a) ∧
      (∀ s ∈ Set.uIcc (0 : Real) 1,
        ∀ a : LiuWang2025SemilinearWaveTransverseJet.Multiindex 3,
          LiuWang2025SemilinearWaveTransverseJet.deg a ≤ N ->
            LiuWang2025SemilinearWaveJetOperators.jetEikonal
              LiuWang2025SemilinearWaveRiccatiPhaseExample.exMetric.Ass
              LiuWang2025SemilinearWaveRiccatiPhaseExample.exMetric.Bs
              LiuWang2025SemilinearWaveRiccatiPhaseExample.exMetric.Att
              P.phi P.dphi a s = 0) :=
  LiuWang2025SemilinearWaveRiccatiPhaseExample.exists_example_phase N

/-- **The example's `C` is literally `diag(0,2,2)`.** -/
theorem riccatiBridgeVerificationBundle_exampleC (s : Real) (p q : Fin 3) :
    LiuWang2025SemilinearWaveRiccatiPhaseBridge.metricC
        LiuWang2025SemilinearWaveRiccatiPhaseExample.exMetric s p q
      = LiuWang2025SemilinearWaveRiccatiPhaseExample.exC p q :=
  LiuWang2025SemilinearWaveRiccatiPhaseExample.exMetric_C s p q

/-- ... and its `D` is not zero, so the example is not a flat toy. -/
theorem riccatiBridgeVerificationBundle_exampleD (s : Real) :
    LiuWang2025SemilinearWaveRiccatiPhaseBridge.metricD
      LiuWang2025SemilinearWaveRiccatiPhaseExample.exMetric s 0 0 ≠ 0 :=
  LiuWang2025SemilinearWaveRiccatiPhaseExample.exMetric_D_ne_zero s

end AmplitudeAndExample

/-- **The coordinate wave operator on transverse jets is local in transverse
degree.**  The degree-`a` coefficient reads the amplitude only through degree
`deg a + 2`. -/
theorem amplitudeJetVerificationBundle_boxLocality {d : Nat}
    (W : LiuWang2025SemilinearWaveAmplitudeJetOperators.WaveJetData d)
    {u v : LiuWang2025SemilinearWaveAmplitudeJetOperators.LongJet2 d}
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d} {s : Real}
    (hjet : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b
        ≤ LiuWang2025SemilinearWaveTransverseJet.deg a + 2 ->
      u.jet.c b s = v.jet.c b s)
    (hdjet : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b
        ≤ LiuWang2025SemilinearWaveTransverseJet.deg a + 1 ->
      u.djet.c b s = v.djet.c b s)
    (hddc : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b
        ≤ LiuWang2025SemilinearWaveTransverseJet.deg a ->
      u.ddc b s = v.ddc b s) :
    W.jetBox u a s = W.jetBox v a s :=
  W.jetBox_congr hjet hdjet hddc

/-- **`Box_g phi` at the centre is `trace (C M) + beta^{i1}`**, agreeing with the
existing `TransportCenterGeometry` transport coefficient. -/
theorem amplitudeJetVerificationBundle_boxAtCentre {d : Nat}
    (W : LiuWang2025SemilinearWaveAmplitudeJetOperators.WaveJetData d)
    (P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet W.G)
    (M : Real -> Fin d -> Fin d -> Complex) {s : Real}
    (hsymm : ∀ p q, M s p q = M s q p)
    (hphi2 : ∀ a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d,
      LiuWang2025SemilinearWaveTransverseJet.deg a = 2 ->
        P.phi.c a s = LiuWang2025SemilinearWaveDegreeBlock.quadCoeff (M s) a) :
    W.jetBox (LiuWang2025SemilinearWaveAmplitudeJetOperators.ofSourcePhase P) 0 s
      = (∑ i, ∑ j, (2 * (W.G.Att i j).c 0 s) * M s i j)
        + (W.betaT W.G.i1).c 0 s :=
  W.jetBox_phase_deg_zero_trace P M hsymm hphi2

/-! ## The matrix-coupled amplitude block -/

/-- **The same-degree block identity for the actual transport operator.**  The
coefficient `2` on the longitudinal derivative comes from the Fermi
normalization, and the remainder is a finite matrix on the whole degree-`r`
block.  No diagonality is assumed. -/
theorem amplitudeBlockVerificationBundle_blockIdentity {d : Nat}
    (W : LiuWang2025SemilinearWaveAmplitudeJetOperators.WaveJetData d)
    (P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet W.G)
    (u u' : LiuWang2025SemilinearWaveAmplitudeJetOperators.LongJet2 d)
    (r : Nat) (s : Real)
    (alpha : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r)
    (hjet : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≠ r ->
      u.jet.c b s = u'.jet.c b s)
    (hdjet : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≠ r ->
      u.djet.c b s = u'.djet.c b s) :
    W.jetTransport P u alpha.1 s - W.jetTransport P u' alpha.1 s
      = 2 * (u.djet.c alpha.1 s - u'.djet.c alpha.1 s)
        + ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
            LiuWang2025SemilinearWaveAmplitudeSameDegreeMatrix.transportMatrix
                W P r s alpha beta
              * (u.jet.c beta.1 s - u'.jet.c beta.1 s) :=
  LiuWang2025SemilinearWaveAmplitudeSameDegreeMatrix.jetTransport_block_matrix_form
    W P u u' r s alpha hjet hdjet

/-- **The block equation forces the actual transport coefficient to vanish.** -/
theorem amplitudeBlockVerificationBundle_cancellation {d : Nat}
    (W : LiuWang2025SemilinearWaveAmplitudeJetOperators.WaveJetData d)
    (P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet W.G)
    (u u' : LiuWang2025SemilinearWaveAmplitudeJetOperators.LongJet2 d)
    (r : Nat) (s : Real)
    (alpha : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r)
    (hjet : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≠ r ->
      u.jet.c b s = u'.jet.c b s)
    (hdjet : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≠ r ->
      u.djet.c b s = u'.djet.c b s)
    (hblock : 2 * (u.djet.c alpha.1 s - u'.djet.c alpha.1 s)
        + ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
            LiuWang2025SemilinearWaveAmplitudeSameDegreeMatrix.transportMatrix
                W P r s alpha beta
              * (u.jet.c beta.1 s - u'.jet.c beta.1 s)
      = - W.jetTransport P u' alpha.1 s) :
    W.jetTransport P u alpha.1 s = 0 :=
  LiuWang2025SemilinearWaveAmplitudeSameDegreeMatrix.jetTransport_eq_zero_of_blockEquation
    W P u u' r s alpha hjet hdjet hblock

/-- **One homogeneous amplitude block, constructed.**  The degree-`r` block
system is solved and inserted; on the paper interval the actual hierarchy
expression `- i T_phi a_k + Box_g a_{k-1}` vanishes at every multi-index of that
degree.  This is one block at one degree and one frequency order, not the full
hierarchy. -/
theorem amplitudeBlockVerificationBundle_oneBlock {d : Nat}
    (W : LiuWang2025SemilinearWaveAmplitudeJetOperators.WaveJetData d)
    (P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet W.G)
    (base ukm : LiuWang2025SemilinearWaveAmplitudeJetOperators.LongJet2 d)
    (r : Nat)
    (hreg : LiuWang2025SemilinearWaveAmplitudeBlockRecursion.AmplitudeBlockRegularity
      W P base (fun a s => -Complex.I * W.jetBox ukm a s) r)
    {lo hi : Real} (t0 : Set.Icc lo hi)
    (x0 : LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r) :
    ∃ u : LiuWang2025SemilinearWaveAmplitudeJetOperators.LongJet2 d,
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a ≠ r ->
          u.jet.c a s = base.jet.c a s) ∧
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a ≠ r ->
          u.djet.c a s = base.djet.c a s) ∧
      (∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
        u.jet.c a.1 (t0 : Real) = base.jet.c a.1 (t0 : Real) + x0 a) ∧
      (∀ s ∈ Set.Icc lo hi,
        ∀ a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d,
          LiuWang2025SemilinearWaveTransverseJet.deg a = r ->
            W.jetHierarchy P u ukm a s = 0) :=
  LiuWang2025SemilinearWaveAmplitudeBlockRecursion.exists_amplitude_block_hierarchy_zero
    W P base ukm r hreg t0 x0

