/-- Paper-dossier export of the variation-of-constants solution of the
source's inhomogeneous transport equation `2 a' + q a = f`: the explicit
formula has the stated actual derivative and solves the equation. -/
theorem transportHierarchyVerificationBundle_inhomogeneous
    {q f : Real -> Complex} (hq : Continuous q) (hf : Continuous f)
    (s0 : Real) (initial : Complex) (s : Real) :
    HasDerivAt (hierarchyAmplitude q f s0 initial)
        (-((2 : Complex))⁻¹ * q s * hierarchyAmplitude q f s0 initial s
          + ((2 : Complex))⁻¹ * f s) s ∧
      2 * (-((2 : Complex))⁻¹ * q s * hierarchyAmplitude q f s0 initial s
            + ((2 : Complex))⁻¹ * f s)
        + q s * hierarchyAmplitude q f s0 initial s = f s :=
  ⟨hierarchyAmplitude_hasDerivAt hq hf s0 initial s,
    hierarchyAmplitude_solves hq hf s0 initial s⟩

/-- Paper-dossier export of the source's recursion
`- i T a_{k+1} + Box_g a_k = 0` on the geodesic, written through the
beam-centre transport operator of the Fermi chart. -/
theorem transportHierarchyVerificationBundle_recursion
    {q : Real -> Complex} (hq : Continuous q)
    (geom : Real -> TransportCenterGeometry iota)
    (hcoef : ∀ tau, q tau = (geom tau).transportCoefficient)
