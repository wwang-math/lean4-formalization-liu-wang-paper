/-- Paper-dossier export of the one-dimensional frequency-scaled Gaussian
integral: each transverse direction contributes exactly one factor
`(sqrt rho)^{-1}`. -/
theorem gaussianMassVerificationBundle_oneDimensional
    {b rho : Real} (hb : 0 < b) (hrho : 0 < rho) :
    (∫ x : Real, Real.exp (-(b * rho) * x ^ 2))
      = Real.sqrt (Real.pi / b) / Real.sqrt rho :=
  integral_scaledGaussian hb hrho

/-- Paper-dossier export of the `d`-dimensional squared transverse mass
`rho^{-d/2}`. -/
theorem gaussianMassVerificationBundle_squaredMass
    {d : Nat} {b rho : Real} (hb : 0 < b) (hrho : 0 < rho) :
    (∫ z : Fin d -> Real, Real.exp (-(b * rho) * radiusSq z))
      = Real.sqrt (Real.pi / b) ^ d * rho ^ (-(d : Real) / 2) :=
  integral_scaledGaussian_rpow hb hrho

/-- Paper-dossier export of the source's `rho^{-d/4}`: it is the square root
of the computed transverse mass, not a postulated exponent. -/
theorem gaussianMassVerificationBundle_normScaling
    {d : Nat} {b rho : Real} (hb : 0 < b) (hrho : 0 < rho) :
    Real.sqrt (∫ z : Fin d -> Real, Real.exp (-(b * rho) * radiusSq z))
      = Real.sqrt (Real.sqrt (Real.pi / b) ^ d) * rho ^ (-(d : Real) / 4) :=
  sqrt_integral_scaledGaussian hb hrho

/-- Paper-dossier export of the transverse moment scaling: each transverse
coordinate factor costs exactly one half-power of the frequency. -/
theorem gaussianMassVerificationBundle_momentScaling
    (m : Nat) {b rho : Real} (hb : 0 < b) (hrho : 0 < rho) :
    (∫ x : Real, x ^ (2 * m) * Real.exp (-(b * rho) * x ^ 2))
      = rho ^ (-((m : Real) + 1 / 2))
        * ∫ y : Real, y ^ (2 * m) * Real.exp (-b * y ^ 2) :=
  integral_moment_scaledGaussian_rpow m hb hrho

