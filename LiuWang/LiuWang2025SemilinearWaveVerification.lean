/-! ## Source conditions (i)--(ii) and the factorial Taylor expansion -/

section HolomorphicExpansion

open LiuWang2025SemilinearWaveHolomorphicExpansion

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace Complex E] [CompleteSpace E]

/-- Paper-dossier export of the source's conditions (i) and (ii).  For a
holomorphic parameter map into any complex Banach space of coefficient
functions, Lean derives the vanishing of the zeroth and first Taylor
coefficients, the globally convergent factorial expansion, the version
started at `k = 2` displayed in the paper, and the scalar display obtained by
evaluating with any continuous linear functional. -/
def holomorphicExpansionVerificationBundle (S : SourceNonlinearity E) :
    LiuWang2025SemilinearWaveHolomorphicExpansion.Certificate S :=
  LiuWang2025SemilinearWaveHolomorphicExpansion.certificate S

/-- The paper's displayed expansion `V(x, z) = sum_{k >= 2} V_k(x) z^k / k!`,
derived rather than assumed. -/
theorem holomorphicExpansionVerificationBundle_tail (S : SourceNonlinearity E)
    (z : Complex) :
    HasSum
      (fun k : Nat =>
        ((Nat.factorial (k + 2) : Complex))⁻¹ • (z ^ (k + 2) • S.coeff (k + 2)))
      (S.V z) :=
  (holomorphicExpansionVerificationBundle S).expansionStartsAtTwo z

/-- The scalar-valued case now *constructs* the recovery module's expansion
packet; `hasSum_factorialExpansion` is no longer an input there. -/
def holomorphicExpansionGeneratedPointwiseExpansion
    (S : SourceNonlinearity Complex) :
    LiuWang2025SemilinearWaveHolomorphicRecovery.PointwiseExpansion :=
  S.toPointwiseExpansion

theorem holomorphicExpansionGeneratedPointwiseExpansion_nonlinearity
    (S : SourceNonlinearity Complex) :
    (holomorphicExpansionGeneratedPointwiseExpansion S).nonlinearity = S.V := rfl

theorem holomorphicExpansionGeneratedPointwiseExpansion_coefficients
    (S : SourceNonlinearity Complex) :
    (holomorphicExpansionGeneratedPointwiseExpansion S).coefficients = S.coeff := rfl

/-- Equality of every recovered Taylor coefficient forces equality of the
nonlinearities at every complex parameter, for values in any complex Banach
space. -/
theorem holomorphicExpansionVerificationBundle_eq_of_coeff_eq
    (S T : SourceNonlinearity E) (hcoeff : ∀ k, S.coeff k = T.coeff k)
    (z : Complex) : S.V z = T.V z :=
  SourceNonlinearity.eq_of_coeff_eq S T hcoeff z


/-- **Paper-dossier export of the source's induction on the order.**
Subsection 4.3 recovers `V_m`, `m >= 4`, assuming `V_3, ..., V_{m-1}` already
recovered, the base case being the cubic recovery of Subsection 4.2.  The
induction itself is a theorem here; the per-order step is the input, and it is
exactly what the reflected-beam point-recovery packet supplies. -/
theorem holomorphicExpansionVerificationBundle_orderInduction
    {alpha : Type*} {S T : Nat -> alpha}
    (hstep : ∀ m, 3 ≤ m -> (∀ k, 3 ≤ k -> k < m -> S k = T k) -> S m = T m) :
    ∀ m, 3 ≤ m -> S m = T m :=
  LiuWang2025SemilinearWaveHolomorphicExpansion.forall_eq_of_inductive_step hstep

/-- **Paper-dossier export of the source's final sentence.**  Conditions (ii)
kill the zeroth and first Taylor coefficients, the source assumes `V_2 = 0`, and
the induction supplies every coefficient from the third on; the `C^alpha`
convergent factorial expansion then forces the two nonlinearities to agree at
every complex parameter. -/
theorem holomorphicExpansionVerificationBundle_fullRecovery
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Complex E] [CompleteSpace E]
    (S T : LiuWang2025SemilinearWaveHolomorphicExpansion.SourceNonlinearity E)
    (hS2 : S.coeff 2 = 0) (hT2 : T.coeff 2 = 0)
    (hstep : ∀ m, 3 ≤ m ->
      (∀ k, 3 ≤ k -> k < m -> S.coeff k = T.coeff k) -> S.coeff m = T.coeff m)
    (z : Complex) : S.V z = T.V z :=
  LiuWang2025SemilinearWaveHolomorphicExpansion.eq_of_cubic_and_inductive_step
    S T hS2 hT2 hstep z

end HolomorphicExpansion

/-! ## Source Fermi-chart eikonal jet and equation (3.8) from the metric -/

section FermiEikonalJet

open LiuWang2025SemilinearWaveFermiEikonalJet

variable {iota : Type*} [Fintype iota] [DecidableEq iota]

/-- The eikonal symbol restricted to a transverse Fermi line is twice
differentiable, with the exact derivative formulas used below.  Nothing is
postulated about the jet: both derivatives are produced by the product and
finite-sum rules from the `C^2` metric components. -/
theorem fermiEikonalVerificationBundle_hasDerivatives
    (L : MetricLineJet iota) (F : FermiPhaseLine iota) (t : Real) :
    HasDerivAt (eikonal L F.gradJet) (eikonalDeriv L F.gradJet t) t ∧
      HasDerivAt (eikonalDeriv L F.gradJet) (eikonalDeriv₂ L F.gradJet t) t :=
  ⟨hasDerivAt_eikonal L F.gradJet t, hasDerivAt_eikonalDeriv L F.gradJet t⟩

/-- Zeroth transverse jet: the beam centre is a null curve. -/
theorem fermiEikonalVerificationBundle_center
    {L : MetricLineJet iota} {F : FermiPhaseLine iota}
    {C D : Matrix iota iota Complex} (hN : FermiNormalization L F C D) :
    eikonal L F.gradJet 0 = 0 :=
  eikonal_center_eq_zero hN

/-- First transverse jet vanishes. -/
theorem fermiEikonalVerificationBundle_firstJet
    {L : MetricLineJet iota} {F : FermiPhaseLine iota}
    {C D : Matrix iota iota Complex} (hN : FermiNormalization L F C D) :
    eikonalDeriv L F.gradJet 0 = 0 :=
  eikonal_firstJet_eq_zero hN

/-- **Equation (3.8) read off the metric.**  The second transverse jet of the
source eikonal symbol is `4 w^T (M' + M C M + D) w`, with the paper's own
`C = diag(0, 2, ..., 2)` and `D = (1/4) d^2 g^{11}`. -/
theorem fermiEikonalVerificationBundle_secondJet
    {L : MetricLineJet iota} {F : FermiPhaseLine iota}
    {C D : Matrix iota iota Complex} (hN : FermiNormalization L F C D) :
    eikonalDeriv₂ L F.gradJet 0 =
      4 * quadForm (F.dM + F.M * C * F.M + D) F.dir :=
  eikonal_secondJet_eq hN

/-- The propagated Riccati flow of Section 3 supplies the second-order
eikonal condition at every point of the geodesic interval. -/
theorem fermiEikonalVerificationBundle_riccatiFlow
    {L : MetricLineJet iota} {F : FermiPhaseLine iota}
    {C D : Matrix iota iota Complex} (hN : FermiNormalization L F C D)
    (flow : RiccatiFlow iota) {t : Real}
    (ht : t ∈ Set.uIcc flow.startTime flow.endTime)
    (hM : F.M = flow.H t) (hdM : F.dM = flow.dH t)
    (hC : C = flow.C t) (hD : D = flow.D t) :
    eikonalDeriv₂ L F.gradJet 0 = 0 :=
  eikonal_secondJet_eq_zero_of_riccatiFlow hN flow ht hM hdM hC hD

/-- Converse direction: the second-order eikonal condition in every real
transverse direction *forces* the paper's Riccati equation. -/
theorem fermiEikonalVerificationBundle_riccatiFromEikonal
    (fam : FermiEikonalFamily iota)
    (hzero : ∀ w : iota -> Real,
      eikonalDeriv₂ (fam.line w) (fam.phaseLine w).gradJet 0 = 0) :
    fam.dM + fam.M * fam.C * fam.M + fam.D = 0 :=
  fam.riccati_of_eikonal_secondJet_eq_zero hzero

/-- The source transport operator at the beam centre reduces to the scalar
ODE with coefficient `Tr(C M) + beta_1`. -/
theorem fermiTransportVerificationBundle_centerEquation
    (g : TransportCenterGeometry iota) (amp : Complex)
    (dAmp : Option iota -> Complex) :
    g.transport amp dAmp =
      2 * dAmp none - (Matrix.trace (g.C * g.M) + g.beta (some g.i1)) * amp :=
  g.transport_eq amp dAmp

/-- Nonvanishing leading amplitude driven by the *geometric* transport
coefficient of the Fermi chart. -/
def fermiTransportVerificationBundle
    (geom : Real -> TransportCenterGeometry iota) (q : Real -> Complex)
    (hq : Continuous q) (tau0 : Real) {initial : Complex} (hinitial : initial ≠ 0)
    (hcoef : ∀ tau, q tau = (geom tau).transportCoefficient) :
    FermiTransportCertificate geom q tau0 initial :=
  fermiTransportCertificate geom q hq tau0 hinitial hcoef

end FermiEikonalJet

