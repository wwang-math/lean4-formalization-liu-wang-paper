    {c : LiuWang2025SemilinearWaveTransverseJet.Jet d} {K : Real} {N : Nat}
    (hdeg : ∀ a ∈ S, N + 1 ≤ LiuWang2025SemilinearWaveTransverseJet.deg a)
    (hc : ∑ a ∈ S, ‖c a‖ ≤ K) (z : Fin d -> Real)
    (hz : LiuWang2025SemilinearWaveGaussianL2Bridge.radius z ≤ 1) :
    ‖LiuWang2025SemilinearWaveTransverseJet.realize S c z‖
      ≤ K * (LiuWang2025SemilinearWaveGaussianL2Bridge.radius z) ^ (N + 1) :=
  LiuWang2025SemilinearWaveTransverseJet.norm_realize_le_of_degree_ge hdeg hc z hz

/-- **The source's phase ansatz through second order.**  `phi(0) = 0` and the
transverse 2-jet is the symmetrized Riccati unknown; the degree-two eikonal
cancellation itself is the already-proved
`LiuWang2025SemilinearWaveFermiEikonalJet.eikonal_secondJet_eq_zero_of_riccati`. -/
theorem chartBeamVerificationBundle_phaseAnsatzJet {n : Nat} (i0 : Fin n)
    (M : Fin n -> Fin n -> Complex) (l m : Fin n) (x : Fin n -> Real) :
    (LiuWang2025SemilinearWaveChartPhaseAnsatz.phaseAnsatz2 i0 M).val 0 = 0
      ∧ (LiuWang2025SemilinearWaveChartPhaseAnsatz.phaseAnsatz2 i0 M).d2 l m x
          = M m l + M l m :=
  ⟨LiuWang2025SemilinearWaveChartPhaseAnsatz.phaseAnsatz2_val_zero i0 M,
    LiuWang2025SemilinearWaveChartPhaseAnsatz.phaseAnsatz2_d2 i0 M l m x⟩

/-! ## Section 3: the triangular longitudinal recursion

The coefficient families of the phase and of the amplitudes are constructed,
degree by degree along the geodesic, by the repository's integrating-factor
quadrature.  The data of the recursion is the pair (longitudinal coefficient,
source functional) with an explicit triangularity axiom; no cancellation is
recorded in it.

What these endpoints do *not* supply is the identification of that data with a
metric: the jet-level `q` and `src` are not yet computed from `A` and `B` in a
Fermi chart, so `eikonalRiccatiAndTransportHierarchy` remains an open bridge.
-/

/-- **Each constructed phase coefficient solves its own longitudinal ODE**,
with the derivative certified by a `HasDerivAt` witness. -/
theorem jetRecursionVerificationBundle_towerHasDerivAt {d : Nat}
    (T : LiuWang2025SemilinearWaveJetTowerRecursion.TowerData d) (s0 : Real)
    (init : LiuWang2025SemilinearWaveTransverseJet.Multiindex d -> Complex)
    (base : LiuWang2025SemilinearWaveTransverseJet.Multiindex d -> Real -> Complex)
    (baseDeg : Nat) (hbase : ∀ a, Continuous (base a)) (r : Nat)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d}
    (ha : LiuWang2025SemilinearWaveTransverseJet.deg a = baseDeg + r + 1)
    (s : Real) :
    HasDerivAt
      (LiuWang2025SemilinearWaveJetTowerRecursion.TowerData.tower T s0 init base
        baseDeg (r + 1) a)
      (-((2 : Complex))⁻¹ * T.q a s
          * LiuWang2025SemilinearWaveJetTowerRecursion.TowerData.tower T s0 init
              base baseDeg (r + 1) a s
        + ((2 : Complex))⁻¹
            * T.src (baseDeg + r + 1)
                (LiuWang2025SemilinearWaveJetTowerRecursion.TowerData.tower T s0
                  init base baseDeg r) a s) s :=
  LiuWang2025SemilinearWaveJetTowerRecursion.TowerData.tower_hasDerivAt T s0 init
    base baseDeg hbase r ha s

/-- **Every constructed phase degree cancels.**  The prescribed degrees by the
Fermi normalization of the chart, the constructed degrees by the recursion. -/
theorem jetRecursionVerificationBundle_phaseCancellation {d : Nat}
    (T : LiuWang2025SemilinearWaveJetTowerRecursion.TowerData d) (s0 : Real)
    (init : LiuWang2025SemilinearWaveTransverseJet.Multiindex d -> Complex)
    (base dbase : LiuWang2025SemilinearWaveTransverseJet.Multiindex d -> Real -> Complex)
    (baseDeg R : Nat)
    (hnorm : LiuWang2025SemilinearWaveJetTowerRecursion.FermiNormalizedBase T base
      dbase baseDeg)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d}
    (ha : LiuWang2025SemilinearWaveTransverseJet.deg a ≤ baseDeg + R) (s : Real) :
    LiuWang2025SemilinearWaveJetTowerRecursion.towerCoefficient T
      (LiuWang2025SemilinearWaveJetTowerRecursion.TowerData.tower T s0 init base
        baseDeg R)
      (LiuWang2025SemilinearWaveJetTowerRecursion.TowerData.towerDeriv T s0 init
        base baseDeg dbase R) a s = 0 :=
  LiuWang2025SemilinearWaveJetTowerRecursion.towerCoefficient_eq_zero_of_le T s0
    init base dbase baseDeg R hnorm ha s

/-- **Every constructed amplitude coefficient satisfies the source's transport
equation**, at every frequency order and every transverse degree through the
constructed order. -/
theorem jetRecursionVerificationBundle_amplitudeCancellation {d : Nat}
    (H : LiuWang2025SemilinearWaveJetAmplitudeHierarchy.HierarchyData d)
    (s0 : Real)
    (init : Nat -> LiuWang2025SemilinearWaveTransverseJet.Multiindex d -> Complex)
    (base : Nat -> LiuWang2025SemilinearWaveTransverseJet.Multiindex d -> Real -> Complex)
    (hbase : ∀ k a, Continuous (base k a))
    (dbase : Nat -> LiuWang2025SemilinearWaveTransverseJet.Multiindex d -> Real -> Complex)
    (baseDeg R k : Nat)
    (hnorm : LiuWang2025SemilinearWaveJetTowerRecursion.FermiNormalizedBase
      (H.toTower (H.previous s0 init base hbase baseDeg R k)
        (H.previous_continuous s0 init base hbase baseDeg R k))
      (base k) (dbase k) baseDeg)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d}
    (ha : LiuWang2025SemilinearWaveTransverseJet.deg a ≤ baseDeg + R) (s : Real) :
    LiuWang2025SemilinearWaveJetTowerRecursion.towerCoefficient
        (H.toTower (H.previous s0 init base hbase baseDeg R k)
          (H.previous_continuous s0 init base hbase baseDeg R k))
        (H.amplitude s0 init base hbase baseDeg R k)
        (H.amplitudeDeriv s0 init base hbase dbase baseDeg R k) a s = 0 :=
  H.amplitude_coefficient_eq_zero s0 init base hbase dbase baseDeg R k hnorm ha s

/-- **The degree-zero eikonal coefficient, computed.**  With the source's
`phi_0 = 0` and `phi_1 = z^1`, the whole jet-level eikonal symbol collapses at
the beam centre to the single metric coefficient `A^{i1 i1}`, so the
degree-zero cancellation is exactly the null condition on the central curve.
This is a computation, not a hypothesis. -/
theorem jetRecursionVerificationBundle_degreeZeroEikonal {d : Nat}
    (Ass : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (Bs : Fin d -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (Att : Fin d -> Fin d -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (phi dphi : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d) (i1 : Fin d)
    (s : Real) (hphi0 : dphi.c 0 s = 0)
    (hphi1 : ∀ i, phi.c (Pi.single i 1) s = if i = i1 then 1 else 0) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal Ass Bs Att phi dphi 0 s
      = (Att i1 i1).c 0 s :=
  LiuWang2025SemilinearWaveJetOperators.jetEikonal_coeff_zero Ass Bs Att phi dphi
    i1 s hphi0 hphi1

/-- **The realized chart function's longitudinal derivative is the realization
of the derivative coefficients.** -/
theorem jetRecursionVerificationBundle_realizationDerivative {d : Nat}
    (u : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (S : Finset (LiuWang2025SemilinearWaveTransverseJet.Multiindex d))
    (z : Fin d -> Real) (s : Real) :
    HasDerivAt
      (fun t : Real => LiuWang2025SemilinearWaveLongitudinalJet.chartValue u S t z)
      (LiuWang2025SemilinearWaveTransverseJet.realize S (fun a => u.dc a s) z) s :=
  LiuWang2025SemilinearWaveLongitudinalJet.hasDerivAt_chartValue_longitudinal u S z s

/-- **The degree-one jet coefficient is the first transverse derivative at the
beam centre**, so the formal coefficients and the actual derivatives of the
realized polynomial agree at first order. -/
theorem jetRecursionVerificationBundle_firstJetCoefficient {d : Nat}
    (S : Finset (LiuWang2025SemilinearWaveTransverseJet.Multiindex d))
    (c : LiuWang2025SemilinearWaveTransverseJet.Jet d) (i : Fin d)
    (hi : (Pi.single i 1 : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) ∈ S) :
    HasDerivAt
      (fun t : Real => LiuWang2025SemilinearWaveTransverseJet.realize S c
        ((0 : Fin d -> Real) + t • LiuWang2025SemilinearWaveChartWKB.dir i))
      (c (Pi.single i 1)) 0 :=
  LiuWang2025SemilinearWaveLongitudinalJet.realize_transverse_deriv_at_origin S c i hi

/-- **The degree-one eikonal coefficient, computed.**  The whole first
transverse jet of the eikonal collapses to three terms: the longitudinal
derivative of the prescribed linear phase against `A^{s i1}`, the null row and
column of the transverse block against the transverse 2-jet of the phase, and
the first transverse derivative of `A^{i1 i1}`.  Fermi normalization kills all
three, so the source's degree-one cancellation is a computation here, not a
hypothesis. -/
theorem jetRecursionVerificationBundle_degreeOneEikonal {d : Nat}
    (Ass : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (Bs : Fin d -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (Att : Fin d -> Fin d -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (phi dphi : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d) (i1 k : Fin d)
    (s : Real) (hphi0 : dphi.c 0 s = 0)
    (hphi1 : ∀ i, phi.c (Pi.single i 1) s = if i = i1 then 1 else 0)
    (hlinear : dphi.c (Pi.single k 1) s = 0)
    (hnullRow : ∀ j, (Att i1 j).c 0 s = 0)
    (hnullCol : ∀ i, (Att i i1).c 0 s = 0)
    (hsecondOrder : (Att i1 i1).c (Pi.single k 1) s = 0) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal Ass Bs Att phi dphi
      (Pi.single k 1) s = 0 :=
  LiuWang2025SemilinearWaveJetOperators.jetEikonal_coeff_one_eq_zero Ass Bs Att phi
    dphi i1 k s hphi0 hphi1 hlinear hnullRow hnullCol hsecondOrder

/-- **Total degree is additive along the convolution index**, so the
coefficient calculus is graded and the eikonal system triangular. -/
theorem jetRecursionVerificationBundle_gradedConvolution {d : Nat}
    {u v : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d} {p q : Nat}
    (hu : ∀ b s, LiuWang2025SemilinearWaveTransverseJet.deg b < p -> u.c b s = 0)
    (hv : ∀ b s, LiuWang2025SemilinearWaveTransverseJet.deg b < q -> v.c b s = 0)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d}
    (ha : LiuWang2025SemilinearWaveTransverseJet.deg a < p + q) (s : Real) :
    (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.mul u v).c a s = 0 :=
  LiuWang2025SemilinearWaveJetOperators.mul_c_eq_zero_of_deg_lt hu hv ha s

/-! ## Section 3: the Fermi metric jet

These endpoints record exactly what has been proved about the *actual*
variable-metric eikonal jet, as opposed to the abstract triangular system.  The
general-degree decomposition into a scalar longitudinal coefficient is *not*
among them: the degree-`r` block of the eikonal couples distinct multi-indices
of the same total degree, so it is not of that shape.  See the module docstring
of `LiuWang2025SemilinearWaveMetricJetPhaseHierarchy`.
-/

/-- **The coefficient normalization is consistent.**  `c alpha` is the ordinary
monomial coefficient, and `jderiv` -- with its factor `alpha_i + 1` and no
`alpha!` -- is exactly the coefficient family of the transverse partial
derivative of the realized polynomial. -/
theorem jetNormalizationVerificationBundle_jderivCorrespondence {d : Nat}
    (N : Nat) (c : LiuWang2025SemilinearWaveTransverseJet.Jet d) (i : Fin d)
    (z : Fin d -> Real) :
    HasDerivAt
      (fun t : Real => LiuWang2025SemilinearWaveTransverseJet.realize
        (LiuWang2025SemilinearWaveLongitudinalJet.degreeLE d (N + 1)) c
        (z + t • LiuWang2025SemilinearWaveChartWKB.dir i))
      (LiuWang2025SemilinearWaveTransverseJet.realize
        (LiuWang2025SemilinearWaveLongitudinalJet.degreeLE d N)
        (LiuWang2025SemilinearWaveTransverseJet.jderiv i c) z) 0 :=
  LiuWang2025SemilinearWaveLongitudinalJet.hasDerivAt_realize_jderiv N c i z

/-- **Locality of the jet eikonal.**  Its degree-`alpha` coefficient reads the
phase only up to total degree `deg alpha + 1` and the longitudinal derivative
only up to `deg alpha`.  This is the triangularity input, in the form in which
it is actually true of the variable-metric eikonal. -/
theorem jetNormalizationVerificationBundle_eikonalLocality {d : Nat}
    (Ass : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (Bs : Fin d -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (Att : Fin d -> Fin d -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    {phi phi' dphi dphi' : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d}
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d} {s : Real}
    (hphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b
      ≤ LiuWang2025SemilinearWaveTransverseJet.deg a + 1 -> phi.c b s = phi'.c b s)
    (hdphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b
      ≤ LiuWang2025SemilinearWaveTransverseJet.deg a -> dphi.c b s = dphi'.c b s) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal Ass Bs Att phi dphi a s
      = LiuWang2025SemilinearWaveJetOperators.jetEikonal Ass Bs Att phi' dphi' a s :=
  LiuWang2025SemilinearWaveJetOperators.jetEikonal_congr Ass Bs Att hphi hdphi

/-- **The low-order phase facts are derived, not assumed.**  Because `dphi` is
certified to be the longitudinal derivative of `phi`, the source's `phi_0 = 0`
and `phi_1 = z^{i1}` force the longitudinal derivative to vanish in degrees zero
and one by uniqueness of derivatives. -/
theorem metricJetVerificationBundle_derivedLowOrder {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (k : Fin d) (s : Real) :
    P.dphi.c 0 s = 0 ∧ P.dphi.c (Pi.single k 1) s = 0 :=
  ⟨P.dphi_zero s, P.dphi_one k s⟩

/-- **Degree-zero eikonal cancellation for the actual Fermi metric jet.**  The
whole degree-zero coefficient collapses to `A^{i1 i1}` on the central curve,
which the chart's null row kills. -/
theorem metricJetVerificationBundle_degreeZero {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (s : Real) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att P.phi
      P.dphi 0 s = 0 :=
  P.eikonal_deg_zero s

/-- **Degree-one eikonal cancellation for the actual Fermi metric jet.**  The
three surviving terms are killed by the `s`-independence of the linear phase,
by the null row and column, and by the second-order vanishing of
`A^{i1 i1}` -- all chart normalizations, none of them a cancellation
hypothesis. -/
theorem metricJetVerificationBundle_degreeOne {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (k : Fin d) (s : Real) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att P.phi
      P.dphi (Pi.single k 1) s = 0 :=
  P.eikonal_deg_one k s

/-- **The variable-metric eikonal system is triangular.**  The degree-`alpha`
coefficient can only read the phase at degree `deg alpha + 1` through the
transverse derivative, and those contributions are annihilated by the chart's
null row and column.  So it depends on the phase only through degrees at most
`deg alpha`.  This is the triangularity the recursion needs, proved for the
actual variable metric rather than assumed. -/
theorem metricJetVerificationBundle_triangularity {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (P P' : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d} {s : Real}
    (ha : 1 ≤ LiuWang2025SemilinearWaveTransverseJet.deg a)
    (hphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b
      ≤ LiuWang2025SemilinearWaveTransverseJet.deg a -> P.phi.c b s = P'.phi.c b s)
    (hdphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b
      ≤ LiuWang2025SemilinearWaveTransverseJet.deg a -> P.dphi.c b s = P'.dphi.c b s) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att P.phi
        P.dphi a s
      = LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att P'.phi
        P'.dphi a s :=
  LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.eikonal_triangular P P' ha
    hphi hdphi

/-- **The longitudinal derivative enters the degree-`alpha` equation with the
source's `2 lambda`.**  With the chart normalization `A^{s i1}(0) = 1` the
coefficient is exactly `2`, and the entire remaining dependence is displayed as
the transverse-transverse block.  Both are computed from the metric. -/
theorem metricJetVerificationBundle_longitudinalCoefficient {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (P P' : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d} {s : Real}
    (ha : 2 ≤ LiuWang2025SemilinearWaveTransverseJet.deg a)
    (hphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b
      < LiuWang2025SemilinearWaveTransverseJet.deg a -> P.phi.c b s = P'.phi.c b s)
    (hdphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b
      < LiuWang2025SemilinearWaveTransverseJet.deg a -> P.dphi.c b s = P'.dphi.c b s) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att P.phi
          P.dphi a s
        - LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att
          P'.phi P'.dphi a s
      = 2 * (P.dphi.c a s - P'.dphi.c a s)
        + ∑ i, ∑ j,
            ((LiuWang2025SemilinearWaveLongitudinalJet.LongJet.mul (G.Att i j)
                (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.mul
                  (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.transverseDeriv i P.phi)
                  (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.transverseDeriv j P.phi))).c a s
              - (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.mul (G.Att i j)
                (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.mul
                  (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.transverseDeriv i P'.phi)
                  (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.transverseDeriv j P'.phi))).c a s) :=
  LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.eikonal_longitudinal_normalized
    P P' ha hphi hdphi

/-! ## Section 3: the homogeneous degree block

At fixed transverse degree the eikonal system is a genuine finite dimensional
linear system, not a family of scalar equations.  These endpoints record the
block layer, the constructive solution of the block ODE, and the derived
same-degree operator.
-/

/-- **The degree-two Riccati normalization.**  Writing `phi_2 = z^T M z` in
ordinary monomial coordinates, an off-diagonal monomial collects *both* matrix
entries while a square collects one.  Proved, not stipulated. -/
theorem degreeBlockVerificationBundle_riccatiNormalization {d : Nat}
    (M : Fin d -> Fin d -> Complex) {p q : Fin d} (hpq : p ≠ q) :
    LiuWang2025SemilinearWaveDegreeBlock.quadCoeff M
        ((Pi.single p 1 : LiuWang2025SemilinearWaveTransverseJet.Multiindex d)
          + Pi.single q 1) = M p q + M q p
      ∧ LiuWang2025SemilinearWaveDegreeBlock.quadCoeff M
        ((Pi.single p 1 : LiuWang2025SemilinearWaveTransverseJet.Multiindex d)
          + Pi.single p 1) = M p p :=
  ⟨LiuWang2025SemilinearWaveDegreeBlock.quadCoeff_offDiag M hpq,
    LiuWang2025SemilinearWaveDegreeBlock.quadCoeff_diag M p⟩

/-- **Writing a block into a jet touches only that degree.** -/
theorem degreeBlockVerificationBundle_insertion {d r : Nat}
    (u : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (blk dblk : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r)
    (h : ∀ (a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r) (s : Real),
      HasDerivAt (fun t : Real => blk t a) (dblk s a) s)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d}
    (ha : LiuWang2025SemilinearWaveTransverseJet.deg a ≠ r) (s : Real) :
    (LiuWang2025SemilinearWaveDegreeBlock.insertBlock u r blk dblk h).c a s
      = u.c a s :=
  LiuWang2025SemilinearWaveDegreeBlock.insertBlock_c_of_deg_ne u r blk dblk h ha s

/-- **A global state-Lipschitz bound for the block field**, from the row sums of
the same-degree matrix.  This is what lets the compact-interval Picard
iteration run on the whole prescribed interval. -/
theorem degreeBlockVerificationBundle_blockLipschitz {d r : Nat}
    (K : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r -> Complex)
    (source : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r)
    {B : Real} (hBnn : 0 ≤ B) (s : Real)
    (hKb : ∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
      ∑ b, ‖K s a b‖ ≤ B) :
    LipschitzWith (Real.toNNReal (B / 2))
      (LiuWang2025SemilinearWaveDegreeBlockODE.blockField K source s) :=
  LiuWang2025SemilinearWaveDegreeBlockODE.lipschitz_blockField K source hBnn s hKb

/-- **The homogeneous block ODE is solved, not assumed.**  On the whole
prescribed compact interval, with the prescribed initial block, the path is
produced by Picard iteration and satisfies `2 c' + K c = source`
coordinatewise. -/
theorem degreeBlockVerificationBundle_blockODE {d r : Nat}
    (K : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r -> Complex)
    (source : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r)
    (hK : ∀ a b, Continuous fun s => K s a b)
    (hsrc : ∀ a, Continuous fun s => source s a)
    {B : Real} (hBnn : 0 ≤ B) {lo hi : Real}
    (hKb : ∀ s ∈ Set.Icc lo hi,
      ∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
        ∑ b, ‖K s a b‖ ≤ B)
    (t0 : Set.Icc lo hi)
    (x0 : LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r) :
    ∃ c : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r,
      c t0 = x0 ∧ Continuous c ∧
        ∀ t ∈ Set.Icc lo hi,
          HasDerivWithinAt c
            (LiuWang2025SemilinearWaveDegreeBlockODE.blockField K source t (c t))
            (Set.Icc lo hi) t :=
  LiuWang2025SemilinearWaveDegreeBlockODE.exists_blockSolution K source hK hsrc
    hBnn hKb t0 x0

/-- **The same-degree operator is a genuine linear operator.**  Additive and
complex-homogeneous in the perturbation, so on the finite dimensional block of a
homogeneous degree it is a linear map -- which is exactly why the scalar
treatment of that degree is invalid. -/
theorem degreeBlockVerificationBundle_sameDegreeLinearity {d : Nat}
    (Att : Fin d -> Fin d -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (phi phi' delta delta' : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (k : Complex) (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d)
    (s : Real) :
    LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.sameDegreeOp Att phi phi'
          (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.add delta delta') a s
        = LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.sameDegreeOp Att phi
            phi' delta a s
          + LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.sameDegreeOp Att phi
            phi' delta' a s
      ∧ LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.sameDegreeOp Att phi phi'
          (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.smul k delta) a s
        = k * LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.sameDegreeOp Att
            phi phi' delta a s :=
  ⟨LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.sameDegreeOp_add Att phi phi'
      delta delta' a s,
    LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.sameDegreeOp_smul Att phi
      phi' delta k a s⟩

/-- **The same-degree operator is a computed matrix acting on the block.**  Its
entries are the derived operator applied to the standard basis jets, and the
representation theorem follows from the linearity already established. -/
theorem degreeBlockVerificationBundle_matrixRepresentation {d : Nat}
    (Att : Fin d -> Fin d -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (phi phi' delta : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    (r : Nat) (s : Real)
    (hsupp : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≠ r
      -> delta.c b s = 0)
    (alpha : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r) :
    LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.sameDegreeOp Att phi phi'
        delta alpha.1 s
      = ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
          LiuWang2025SemilinearWaveSameDegreeMatrix.eikonalMatrix Att phi phi' r s
            alpha beta * delta.c beta.1 s :=
  LiuWang2025SemilinearWaveSameDegreeMatrix.sameDegreeOp_matrix Att phi phi'
    delta r s hsupp alpha

/-- **The degree-`r` block form of the actual variable-metric eikonal.**  Two
source phase jets differing only in degree `r` have eikonal coefficients
differing by `2 (d_s c - d_s c') + K(s)(c - c')` across the whole block -- the
exact shape of the block ODE's vector field. -/
theorem degreeBlockVerificationBundle_eikonalBlockForm {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (P P' : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (r : Nat) (hr : 2 ≤ r) (s : Real)
    (alpha : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r)
    (hphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b < r
      -> P.phi.c b s = P'.phi.c b s)
    (hdphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b < r
      -> P.dphi.c b s = P'.dphi.c b s)
    (hoff : ∀ b, r < LiuWang2025SemilinearWaveTransverseJet.deg b
      -> P.phi.c b s = P'.phi.c b s) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att P.phi
          P.dphi alpha.1 s
        - LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att
          P'.phi P'.dphi alpha.1 s
      = 2 * (P.dphi.c alpha.1 s - P'.dphi.c alpha.1 s)
        + ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
            LiuWang2025SemilinearWaveSameDegreeMatrix.eikonalMatrix G.Att P.phi
              P'.phi r s alpha beta * (P.phi.c beta.1 s - P'.phi.c beta.1 s) :=
  LiuWang2025SemilinearWaveSameDegreeMatrix.eikonal_block_matrix_form P P' r hr s
    alpha hphi hdphi hoff

/-- **The block equation forces cancellation of the actual eikonal.**  Moving
the degree-`r` block so as to satisfy the block ODE with the base phase's own
eikonal as source kills every degree-`r` coefficient of the real
`jetEikonal`.  This is the recursion step of Section 3, stated against the
actual eikonal. -/
theorem degreeBlockVerificationBundle_recursionStep {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (P P' : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (r : Nat) (hr : 2 ≤ r) (s : Real)
    (hphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b < r
      -> P.phi.c b s = P'.phi.c b s)
    (hdphi : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b < r
      -> P.dphi.c b s = P'.dphi.c b s)
    (hoff : ∀ b, r < LiuWang2025SemilinearWaveTransverseJet.deg b
      -> P.phi.c b s = P'.phi.c b s)
    (alpha : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r)
    (hblock : 2 * (P.dphi.c alpha.1 s - P'.dphi.c alpha.1 s)
        + ∑ beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
            LiuWang2025SemilinearWaveSameDegreeMatrix.eikonalMatrix G.Att P.phi
              P'.phi r s alpha beta * (P.phi.c beta.1 s - P'.phi.c beta.1 s)
      = - LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att
          P'.phi P'.dphi alpha.1 s) :
    LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att P.phi
      P.dphi alpha.1 s = 0 :=
  LiuWang2025SemilinearWaveSameDegreeMatrix.eikonal_deg_eq_zero_of_blockEquation
    P P' r hr s hphi hdphi hoff alpha hblock

/-! ## The corrected degree-`r` block: a matrix free of the unknown phase -/

/-- **The quadratic self-interaction of a degree-`r` perturbation cannot reach
degree `r` when `r >= 3`.**  Its transverse degree is at least `2r - 2 > r`.
This is what removes the unknown phase from the block matrix. -/
theorem phaseUpdateVerificationBundle_selfInteractionVanishes {d : Nat}
    (Att : Fin d -> Fin d
      -> LiuWang2025SemilinearWaveLongitudinalJet.LongJet d)
    {w v : LiuWang2025SemilinearWaveLongitudinalJet.LongJet d} {r : Nat}
    {s : Real} (hr : 3 ≤ r)
    (hw : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≠ r -> w.c b s = 0)
    (hv : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≠ r -> v.c b s = 0)
    {a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d}
    (ha : LiuWang2025SemilinearWaveTransverseJet.deg a = r) (i j : Fin d) :
    (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.mul (Att i j)
      (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.mul
        (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.transverseDeriv i w)
        (LiuWang2025SemilinearWaveLongitudinalJet.LongJet.transverseDeriv j v))).c
      a s = 0 :=
  LiuWang2025SemilinearWaveSameDegreeMatrix.selfInteraction_vanishes Att hr hw hv ha i j

/-- **The block matrix reads the base phase only through degree two.**  So no
later insertion, which only ever touches degrees at least three, can alter it. -/
theorem phaseUpdateVerificationBundle_matrixLocality {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (base base' : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (r : Nat) (hr : 3 ≤ r) (s : Real)
    (hagree : ∀ b, LiuWang2025SemilinearWaveTransverseJet.deg b ≤ 2
      -> base.phi.c b s = base'.phi.c b s)
    (alpha beta : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r) :
    LiuWang2025SemilinearWaveSameDegreeMatrix.phaseEikonalMatrix base r s alpha beta
      = LiuWang2025SemilinearWaveSameDegreeMatrix.phaseEikonalMatrix base' r s
          alpha beta :=
  LiuWang2025SemilinearWaveSameDegreeMatrix.phaseEikonalMatrix_local base base' r hr s
    hagree alpha beta

/-- **The block solution is twice differentiable at every real parameter**, so
no interval derivative is ever passed off as a global one.  Its first and second
derivatives are certified everywhere and the block equation holds on the paper
interval. -/
theorem phaseUpdateVerificationBundle_globalBlockSolution {d r : Nat}
    (K dK : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r -> Complex)
    (source dsource : Real
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r)
    (hKd : ∀ a b s, HasDerivAt (fun v => K v a b) (dK s a b) s)
    (hdK : ∀ a b, Continuous fun s => dK s a b)
    (hsrcd : ∀ a s, HasDerivAt (fun v => source v a) (dsource s a) s)
    (hdsrc : ∀ a, Continuous fun s => dsource s a)
    {B : Real} (hBnn : 0 ≤ B) {lo hi : Real}
    (hKb : ∀ s ∈ Set.Icc lo hi,
      ∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
        ∑ b, ‖K s a b‖ ≤ B)
    (t0 : Set.Icc lo hi)
    (x0 : LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r) :
    ∃ c c' c'' : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r,
      c t0 = x0 ∧
      (∀ (a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r) (t : Real),
        HasDerivAt (fun v => c v a) (c' t a) t) ∧
      (∀ (a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r) (t : Real),
        HasDerivAt (fun v => c' v a) (c'' t a) t) ∧
      (∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
        Continuous fun t => c'' t a) ∧
      (∀ t ∈ Set.Icc lo hi,
        ∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
          2 * c' t a + ∑ b, K t a b * c t b = source t a) :=
  LiuWang2025SemilinearWaveDegreeBlockODE.exists_c2_blockSolution K dK source
    dsource hKd hdK hsrcd hdsrc hBnn hKb t0 x0

/-- **A uniform nonnegative row-sum bound is derived, not assumed.** -/
theorem phaseUpdateVerificationBundle_rowSumBound {d r : Nat}
    {K : Real -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r
      -> LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r -> Complex}
    (hK : ∀ a b, Continuous fun s => K s a b) (lo hi : Real) :
    ∃ B : Real, 0 ≤ B ∧
      ∀ s ∈ Set.Icc lo hi,
        ∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
          ∑ b, ‖K s a b‖ ≤ B :=
  LiuWang2025SemilinearWaveDegreeBlockODE.exists_rowSum_bound hK lo hi

/-- **One phase update, constructed unconditionally.**  Nothing about the block
equation is hypothesised: the matrix and source are read off from the base
phase, the equation is solved, the solution inserted, and every degree-`r`
coefficient of the *actual* `jetEikonal` is proved to vanish on the paper
interval while all other degrees are untouched. -/
theorem phaseUpdateVerificationBundle_onePhaseStep {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
    (base : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G)
    (hbase : LiuWang2025SemilinearWavePhaseUpdate.C1Data G base)
    (r : Nat) (hr : 3 ≤ r) {lo hi : Real} (t0 : Set.Icc lo hi)
    (x0 : LiuWang2025SemilinearWaveDegreeBlock.DegreeBlock d r) :
    ∃ P : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.SourcePhaseJet G,
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a ≠ r ->
          P.phi.c a s = base.phi.c a s) ∧
      (∀ (a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d) (s : Real),
        LiuWang2025SemilinearWaveTransverseJet.deg a ≠ r ->
          P.dphi.c a s = base.dphi.c a s) ∧
      (∀ a : LiuWang2025SemilinearWaveDegreeBlock.DegreeIndex d r,
        P.phi.c a.1 (t0 : Real) = base.phi.c a.1 (t0 : Real) + x0 a) ∧
      LiuWang2025SemilinearWavePhaseUpdate.C1Data G P ∧
      (∀ s ∈ Set.Icc lo hi,
        ∀ a : LiuWang2025SemilinearWaveTransverseJet.Multiindex d,
          LiuWang2025SemilinearWaveTransverseJet.deg a = r ->
            LiuWang2025SemilinearWaveJetOperators.jetEikonal G.Ass G.Bs G.Att
              P.phi P.dphi a s = 0) :=
  LiuWang2025SemilinearWavePhaseUpdate.exists_phase_update base hbase r hr t0 x0

/-- **The phase recursion through arbitrary finite order.**  Degrees zero and
one cancel for every source phase jet; given the degree-two (Riccati) step on
the paper interval, there is a phase agreeing through degree two whose actual
`jetEikonal` coefficients vanish at every multi-index of degree at most `N`. -/
theorem phaseUpdateVerificationBundle_finiteOrderPhaseRecursion {d : Nat}
    {G : LiuWang2025SemilinearWaveMetricJetPhaseHierarchy.FermiMetricJet d}
